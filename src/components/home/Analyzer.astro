---
// Sección «Lo que revisa el analizador»: cabecera + isla de React (AnalyzerPeek) que hidrata al entrar en pantalla.
// Los datos salen de src/lib/checks.ts (espejo de la rúbrica de api/analyze.js). Sin JS: se ven los 4 grupos
// completos y el formulario igual lleva a /analiza?url=… (GET nativo).
import AnalyzerPeek from './AnalyzerPeek.tsx';
import { totalChecks } from '../../lib/checks';
---
<section class="sec anl" id="analizador" aria-labelledby="anl-h">
  <div class="wrap-sec anl-grid">
    <div class="sec-head">
      <h2 id="anl-h">Esto es lo que revisa el analizador en tu web.</h2>
      <p class="lead">Son {totalChecks} revisiones en cuatro grupos, las mismas con que auditamos un sitio. Cada una suma puntos a una nota de 0 a 100. Elige un grupo para ver qué mira y cuánto pesa.</p>
      <p class="anl-note">La nota es gratis. Con tu nombre y correo se suman la velocidad real de PageSpeed y un chequeo de si una IA te citaría.</p>
    </div>
    <div class="anl-island">
      <AnalyzerPeek client:visible={{ rootMargin: '200px' }} />
    </div>
  </div>
  <noscript><style>.ap-panel[hidden] { display: block; } .ap-tabs, .ap-weight, .ap-scan { display: none; } .ap-gname { display: block !important; }</style></noscript>
</section>

<style>
  .anl-grid { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); gap: 4rem; align-items: start; }
  .anl .sec-head { order: 2; position: sticky; top: 7rem; }
  .anl-island { order: 1; min-width: 0; }
  .anl-note { margin-top: 1.25rem; max-width: 46ch; color: var(--faint); font-size: 0.92rem; line-height: 1.5; }
  @media (max-width: 900px) {
    .anl-grid { grid-template-columns: minmax(0, 1fr); gap: 2.25rem; }
    .anl .sec-head { order: 0; position: static; }
  }
</style>

<style is:global>
  /* La isla la renderiza React (sin data-astro-cid): estilos globales con prefijo .ap- */
  .ap {
    position: relative; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg);
    box-shadow: var(--shadow-card); overflow: hidden;
  }
  .ap-tabs { position: relative; display: flex; gap: 0.25rem; padding: 0.5rem 0.75rem 0; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .ap-tabs button {
    position: relative; flex: 0 0 auto; display: inline-flex; align-items: center; gap: 0.5rem; height: 3rem; padding: 0 0.875rem;
    border: 0; background: none; cursor: pointer; font: 600 0.95rem/1 var(--font-body); color: var(--muted); border-radius: 0.5rem 0.5rem 0 0;
    transition: color 0.18s;
  }
  .ap-tabs button:hover { color: var(--ink); }
  .ap-tabs button[aria-selected='true'] { color: var(--accent); }
  .ap-tabs button:focus-visible { outline-offset: -2px; }
  /* sin hidratar: subrayado fijo bajo la pestaña activa; hidratada: el subrayado deslizante (.ap-ind) lo reemplaza */
  .ap-tabs button[aria-selected='true']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent); }
  .ap-live .ap-tabs button::after { display: none; }
  .ap-ind { display: none; position: absolute; left: 0; bottom: -1px; width: 1px; height: 2px; background: var(--accent); transform-origin: 0 50%; }
  .ap-live .ap-ind { display: block; }
  .ap-count {
    min-width: 1.5rem; height: 1.5rem; padding: 0 0.375rem; border-radius: 999px; display: inline-grid; place-items: center;
    background: var(--bubble); color: var(--muted); font-size: 0.78rem; font-weight: 700;
  }
  .ap-tabs button[aria-selected='true'] .ap-count { background: var(--accent-tint); color: var(--accent); }

  .ap-weight { display: grid; gap: 0.625rem; padding: 1.125rem 1.5rem 0.25rem; font-size: 0.92rem; color: var(--muted); }
  .ap-weight strong { color: var(--ink); font-weight: 700; }
  .ap-bar { display: block; height: 0.375rem; border-radius: 999px; background: var(--bubble); overflow: hidden; }
  .ap-fill { display: block; height: 100%; border-radius: inherit; background: var(--accent); transform-origin: 0 50%; }

  .ap-panels { position: relative; padding: 0.5rem 0.75rem 0.75rem; }
  .ap-gname { display: none; padding: 0.75rem 0.75rem 0.25rem; font-size: 1.1rem; letter-spacing: -0.03em; }
  .ap-list { list-style: none; margin: 0; padding: 0; }
  .ap-row {
    position: relative; display: grid; grid-template-columns: 1.75rem 1fr auto; gap: 0.875rem; align-items: start;
    padding: 0.875rem 0.75rem; border-radius: var(--radius);
  }
  .ap-row + .ap-row::before { content: ''; position: absolute; left: 3.375rem; right: 0.75rem; top: 0; height: 1px; background: var(--line); }
  .ap-flash { position: absolute; inset: 0; border-radius: inherit; background: var(--accent-tint); opacity: 0; pointer-events: none; }
  /* punto de luz (no un check verde: esto es lo que se revisa, no un aprobado) */
  .ap-ok {
    position: relative; width: 1.75rem; height: 1.75rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--accent-tint);
  }
  .ap-ok::after { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0.1875rem color-mix(in srgb, var(--accent) 22%, transparent); }
  .ap-txt { position: relative; display: grid; gap: 0.1875rem; min-width: 0; }
  .ap-label { font-weight: 650; color: var(--ink); line-height: 1.3; }
  .ap-what { font-size: 0.9rem; color: var(--muted); line-height: 1.45; }
  .ap-pts { position: relative; padding-top: 0.125rem; font-size: 0.84rem; color: var(--faint); white-space: nowrap; }
  .ap-scan {
    position: absolute; left: 0; right: 0; height: 3.5rem; margin-top: -3.5rem; opacity: 0; pointer-events: none; z-index: 1;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--accent) 10%, transparent) 70%, var(--accent) calc(100% - 1px), transparent);
  }

  .ap-form { padding: 1.125rem 1.5rem 1.5rem; border-top: 1px solid var(--line); background: var(--bg-soft); }
  .ap-flabel { display: block; margin-bottom: 0.625rem; font-size: 0.92rem; font-weight: 600; color: var(--ink-2); }
  .ap-frow { display: flex; gap: 0.625rem; }
  .ap-frow input {
    flex: 1; min-width: 0; height: 3.25rem; padding: 0 1rem; border: 1px solid var(--line-strong); border-radius: var(--radius);
    background: var(--bg); color: var(--ink); font: 400 1rem var(--font-body); transition: border-color 0.18s, box-shadow 0.18s;
  }
  .ap-frow input::placeholder { color: var(--faint); }
  .ap-frow input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 0.25rem var(--accent-tint); }
  @media (max-width: 520px) {
    .ap-weight { padding-inline: 1.125rem; }
    .ap-tabs { padding-inline: 0.375rem; gap: 0; }
    .ap-tabs button { padding: 0 0.625rem; font-size: 0.9rem; }
    .ap-count { display: none; }
    .ap-row { grid-template-columns: 1.75rem minmax(0, 1fr); row-gap: 0.25rem; }
    .ap-pts { grid-column: 2; padding-top: 0; }
    .ap-form { padding-inline: 1.125rem; }
    .ap-frow { flex-direction: column; }
    .ap-frow input { flex: none; }
    .ap-frow .btn { width: 100%; }
  }
</style>
