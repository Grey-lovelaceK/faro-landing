---
// La tesis de Faro°, en vivo: una IA responde a una pregunta real de cliente y cita a Faro°.
// La respuesta se escribe letra a letra (desacelera al llegar a la marca). Con movimiento reducido, aparece completa.
// El campo inferior NO es un chat: es un enlace al analizador, con el aspecto de la pregunta siguiente.
import Icon from '../Icon.astro';
const question = 'quién me puede hacer una web y posicionarla en Chile';
const answer = { before: 'Para eso te recomiendo ', brand: 'FARO°', after: '... Diseñan tu web y la posicionan para Google y respuestas de IA.' };
---
<div class="ai-stage" data-follow>
  <div class="ai-halo" aria-hidden="true"></div>
  <figure class="ai-card" data-spot aria-label="Ejemplo de una respuesta de asistente de IA que recomienda a Faro°">
    <span class="ai-sweep" aria-hidden="true"></span>
    <header class="ai-head">
      <span class="ai-spark"><Icon name="sparkle" size={26} /></span>
      <span class="ai-label">Asistente de visibilidad IA</span>
      <span class="ai-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </header>
    <div class="ai-body">
      <div class="ai-row">
        <span class="ai-avatar"><Icon name="user" size={28} /></span>
        <p class="ai-bubble ai-q">{question}</p>
      </div>
      <div class="ai-row">
        <span class="ai-avatar ai-avatar-bot"><Icon name="sparkle" size={28} /></span>
        <p class="ai-bubble ai-a" id="ai-answer" data-before={answer.before} data-brand={answer.brand} data-after={answer.after}>
          {answer.before}<strong class="ai-cite">{answer.brand}</strong>{answer.after}
        </p>
      </div>
      <a class="ai-input" href="/analiza">
        <Icon name="clip" size={22} class="ai-clip" />
        <span class="ai-sep" aria-hidden="true"></span>
        <span class="ai-placeholder"><span class="ai-ph-long">¿Te recomendaría a ti? </span>Analiza tu web gratis</span>
        <span class="ai-send"><Icon name="send" size={22} label="Ir al analizador" /></span>
      </a>
    </div>
  </figure>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('ai-answer');
    if (!el || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) return;
    var a = el.dataset.before, b = el.dataset.brand, c = el.dataset.after, full = a + b + c;
    var esc = function (s) { return s.replace(/[&<>]/g, function (x) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[x]; }); };
    function render(n) {
      var pre = full.slice(0, Math.min(n, a.length));
      var mid = n > a.length ? full.slice(a.length, Math.min(n, a.length + b.length)) : '';
      var post = n > a.length + b.length ? full.slice(a.length + b.length, n) : '';
      el.innerHTML = esc(pre) + (mid ? '<strong class="ai-cite">' + esc(mid) + '</strong>' : '') + esc(post) + '<span class="ai-cursor" aria-hidden="true"></span>';
    }
    // El haz cruza la tarjeta primero (CSS, ~1 s) y recién ahí la respuesta empieza a escribirse.
    // Al terminar, la cita FARO° queda marcada (la clase .typing se quita y el subrayado crece).
    var i = 0; el.classList.add('typing'); render(0);
    function tick() { i++; render(i); if (i < full.length) setTimeout(tick, i >= a.length - 1 && i <= a.length + b.length ? 70 : 24); else setTimeout(function () { el.classList.remove('typing'); }, 120); }
    setTimeout(tick, 900);
  })();
</script>

<style>
  .ai-stage { position: relative; width: min(51.8125rem, 100%); margin-inline: auto; }
  /* --fx/--fy (-1..1) los escribe public/vida.js según el puntero dentro del héroe: el halo se corre hacia
     donde apunta el visitante y la tarjeta se mueve apenas al revés (profundidad). Sin JS valen 0. */
  .ai-stage { view-timeline: --ai-stage block; }
  .ai-halo {
    position: absolute; left: 50%; top: 52%; width: 150%; height: 160%; transform: translate(-50%, -50%);
    translate: calc(var(--fx, 0) * 4rem) calc(var(--fy, 0) * 2.5rem);
    background: radial-gradient(closest-side, var(--halo) 50%, transparent); filter: blur(0.625rem); pointer-events: none;
    animation: ai-breathe 7s ease-in-out infinite;
  }
  @keyframes ai-breathe { 50% { opacity: 0.7; scale: 0.97; } }
  .ai-card {
    position: relative; margin: 0; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card); overflow: hidden;
    translate: calc(var(--fx, 0) * -0.375rem) calc(var(--fy, 0) * -0.25rem);
  }
  /* la tarjeta tiene overflow: hidden, así que su borde de luz va por dentro */
  .ai-card[data-spot]::after { inset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    /* el haz del faro cruza la tarjeta una vez al cargar */
    .ai-sweep {
      position: absolute; inset: 0; z-index: 2; pointer-events: none;
      background: linear-gradient(100deg, transparent 38%, color-mix(in srgb, var(--accent) 16%, transparent) 47%, color-mix(in srgb, var(--accent) 28%, transparent) 50%, color-mix(in srgb, var(--accent) 16%, transparent) 53%, transparent 62%);
      transform: translateX(-100%); animation: ai-sweep 1.15s cubic-bezier(0.65, 0, 0.35, 1) 0.35s both;
    }
    /* al hacer scroll hacia abajo la tarjeta sube un poco más rápido que la página y el halo se apaga */
    @supports (animation-timeline: view()) {
      .ai-card { animation: ai-lift linear both; animation-timeline: --ai-stage; animation-range: exit 0% exit 100%; }
      .ai-halo { animation: ai-breathe 7s ease-in-out infinite, ai-dim linear both; animation-timeline: auto, --ai-stage; animation-range: normal, exit -10% exit 80%; }
    }
  }
  .ai-sweep { display: none; }
  @media (prefers-reduced-motion: no-preference) { .ai-sweep { display: block; } }
  @keyframes ai-sweep { to { transform: translateX(100%); } }
  @keyframes ai-lift { to { transform: translateY(-2rem); } }
  @keyframes ai-dim { to { opacity: 0.2; } }
  .ai-head { display: flex; align-items: center; gap: 0.875rem; height: 3.625rem; padding: 0 1.25rem; border-bottom: 1px solid var(--line); }
  .ai-spark { color: var(--accent); }
  .ai-label { font-size: 0.95rem; font-weight: 600; letter-spacing: -0.005em; color: var(--ink-2); }
  .ai-dots { margin-left: auto; display: flex; gap: 0.6875rem; }
  .ai-dots i { width: 0.5625rem; height: 0.5625rem; border-radius: 50%; background: var(--line-strong); }
  .ai-body { padding: 1.375rem 1.625rem 1.25rem; display: grid; gap: 1.25rem; }
  .ai-row { display: grid; grid-template-columns: 3.4375rem 1fr; gap: 1.375rem; align-items: start; }
  .ai-avatar { width: 3.4375rem; height: 3.4375rem; border-radius: 50%; display: grid; place-items: center; background: var(--bubble); color: var(--muted); }
  .ai-avatar-bot { background: var(--accent-tint); color: var(--accent); }
  .ai-bubble { font-size: 1.14rem; line-height: 1.45; color: var(--ink); border-radius: var(--radius); }
  .ai-q { justify-self: start; background: var(--bubble); padding: 1rem 1.25rem; }
  .ai-a { border: 1px solid var(--line); padding: 0.875rem max(1.25rem, calc(100% - 27em)) 0.875rem 1.25rem; min-height: 5.25rem; }
  /* global: el script vuelve a crear este <strong> por innerHTML, sin el atributo de alcance de Astro */
  :global(.ai-cite) {
    color: var(--accent); font-weight: 700; padding: 0 0.08em;
    background: linear-gradient(var(--accent-tint), var(--accent-tint)) 0 92% / 100% 0.45em no-repeat;
    transition: background-size 0.6s var(--ease-out);
  }
  :global(.typing .ai-cite) { background-size: 0 0.45em; }
  :global(.ai-cursor) { display: inline-block; width: 0.1875rem; height: 1.1em; margin-left: 0.625rem; background: var(--accent); vertical-align: -0.18em; animation: ai-blink 1s steps(1) infinite; }
  @keyframes ai-blink { 50% { opacity: 0; } }
  .ai-input {
    display: flex; align-items: center; gap: 0.875rem; height: 3.625rem; margin-top: 0.5rem; padding: 0 0.1875rem 0 1.375rem;
    border: 1px solid var(--line); border-radius: 62.4375rem; text-decoration: none; color: var(--faint);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ai-input:hover { border-color: var(--accent-line); box-shadow: 0 0 0 0.25rem var(--accent-tint); }
  .ai-sep { width: 1px; height: 1.625rem; background: var(--line-strong); }
  .ai-placeholder { min-width: 0; font-size: 1.02rem; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ai-send { margin-left: auto; width: 3.25rem; height: 3.25rem; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--on-accent); }
  @media (max-width: 640px) {
    .ai-head { padding: 0 0.875rem; }
    .ai-body { padding: 1rem; gap: 0.875rem; }
    .ai-row { grid-template-columns: 2.5rem 1fr; gap: 0.75rem; }
    .ai-avatar { width: 2.5rem; height: 2.5rem; }
    .ai-bubble { font-size: 1.02rem; }
    .ai-dots { display: none; }
    .ai-ph-long { display: none; }
    .ai-input { gap: 0.625rem; padding-left: 1rem; }
  }
</style>
