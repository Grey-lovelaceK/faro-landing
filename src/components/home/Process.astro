---
// Cuatro etapas sobre una sola línea: el haz del faro avanza de una a la siguiente.
const steps = [
  { t: 'Escuchamos', d: 'Entendemos tu negocio, tu cliente y con quién compites hoy, en Google y en la IA.' },
  { t: 'Creamos', d: 'Identidad y sitio a medida, pensados para que una visita se convierta en contacto.' },
  { t: 'Te hacemos visible', d: 'SEO técnico, contenido y estructura para rankear y para que la IA te cite.' },
  { t: 'Medimos y ajustamos', d: 'Reportes con lo que importa, consultas y ventas, y ajustes mes a mes.' },
];
---
<section class="sec proc" id="proceso" aria-labelledby="proc-h">
  <div class="wrap-sec">
    <div class="sec-head center">
      <h2 id="proc-h">De la idea al primer cliente que te encuentra.</h2>
    </div>
    <ol class="steps" role="list">
      {steps.map((s, i) => (
        <li class="step" style={`--i:${i}`}>
          <span class="node num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 4rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; position: relative; }
  .steps::before {
    content: ''; position: absolute; left: 1.75rem; right: 1.75rem; top: 1.6875rem; height: 1px;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-line) 40%, var(--line) 100%);
  }
  .step { position: relative; }
  /* el haz: con JS, la línea se dibuja y cada nodo se enciende en orden al entrar en pantalla */
  .steps.dim::before { transform: scaleX(0); transform-origin: left; }
  .steps.dim.lit::before { transform: none; transition: transform 1.4s var(--ease-out) 0.15s; }
  .steps.dim .node { transition: background-color 0.4s, border-color 0.4s, color 0.4s, box-shadow 0.4s; }
  .steps.dim.lit .step .node { background: var(--accent-tint); border-color: var(--accent); transition-delay: calc(0.3s + var(--i) * 0.32s); }
  .steps.dim.lit .step:first-child .node { background: var(--accent); }
  .node {
    position: relative; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%;
    background: var(--bg); border: 1px solid var(--accent-line); color: var(--accent); font-size: 0.92rem; font-weight: 600;
    box-shadow: 0 0 0 0.5rem var(--bg);
  }
  .step:first-child .node { background: var(--accent); border-color: var(--accent); color: var(--on-accent); box-shadow: 0 0 0 0.5rem var(--bg), 0 0.625rem 1.875rem -8px var(--halo); }
  .step h3 { margin-top: 1.75rem; font-size: 1.5rem; line-height: 1.1; }
  .step p { margin-top: 0.625rem; color: var(--muted); line-height: 1.55; max-width: 30ch; }
  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr 1fr; row-gap: 3rem; }
    .steps::before { display: none; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; gap: 0; margin-top: 2.75rem; }
    .step { display: grid; grid-template-columns: 3.5rem 1fr; column-gap: 1.25rem; padding-bottom: 2rem; }
    .step::before { content: ''; position: absolute; left: 1.75rem; top: 3.5rem; bottom: 0; width: 1px; background: var(--line); }
    .step:last-child::before { display: none; }
    .node { grid-row: span 2; }
    .step h3 { margin-top: 0.75rem; }
    .step h3, .step p { grid-column: 2; }
  }
</style>
