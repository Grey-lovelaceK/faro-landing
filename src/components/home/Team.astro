---
// Las dos personas que hacen el trabajo. Monogramas hasta que suban sus fotos.
// La prueba es verificable: este mismo sitio, pasado por el analizador.
import Icon from '../Icon.astro';
const people = [
  { id: 'clementina', ini: 'CM', name: 'Clementina Moya', role: 'Cofundadora · Directora creativa y de marketing', bio: 'Graduada en marketing y redacción, diseñadora. Define el mensaje que convierte, la identidad visual y la estrategia de contenido.', skills: ['Estrategia y posicionamiento de marca', 'Textos que venden', 'Contenido para SEO, redes y campañas'] },
  { id: 'cristian', ini: 'CF', name: 'Cristian Florez Revilla', role: 'Cofundador · Director técnico', bio: 'Desarrollador full stack. Construye el sitio, el SEO técnico, el AEO/GEO y los reportes que miden ventas reales.', skills: ['Desarrollo web a medida', 'SEO técnico + AEO / GEO', 'Analítica y dashboards de negocio'] },
];
---
<section class="sec team" id="equipo" aria-labelledby="team-h">
  <div class="wrap-sec team-grid">
    <div class="sec-head">
      <h2 id="team-h">Un estudio, dos especialistas. Trabajas directo con nosotros.</h2>
      <p class="lead">Nada tercerizado ni call center: hablas con quienes hacen el trabajo. Estrategia y contenido de un lado, desarrollo y datos del otro.</p>
      <div class="proof">
        <p><strong>Este sitio lo diseñamos, escribimos y optimizamos nosotros.</strong> Pásalo por el analizador y mira la nota que saca.</p>
        <a href="/analiza" class="btn btn-ghost btn-sm">Probar el analizador <Icon name="arrow" size={18} stroke={2} /></a>
      </div>
    </div>
    <ul class="people" role="list">
      {people.map((p) => (
        <li class="person">
          <span class="mono-av" aria-hidden="true">{p.ini}</span>
          <div>
            <h3>{p.name}</h3>
            <p class="p-role">{p.role}</p>
            <p class="p-bio">{p.bio}</p>
            <ul class="p-skills" role="list">{p.skills.map((s) => <li>{s}</li>)}</ul>
          </div>
        </li>
      ))}
      <li class="more"><a class="link" href="/nosotros">Conoce más sobre nosotros <Icon name="arrow" size={18} stroke={2} /></a></li>
    </ul>
  </div>
</section>

<style>
  .team-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 4rem; align-items: start; }
  .proof { margin-top: 2rem; padding: 1.25rem 1.375rem; border-radius: var(--radius); background: var(--bg-soft); border: 1px solid var(--line); display: grid; gap: 1rem; justify-items: start; }
  .proof p { color: var(--muted); line-height: 1.5; }
  .proof strong { color: var(--ink); font-weight: 650; }
  .people { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .person { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1.5rem; padding: 1.75rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg); }
  .mono-av {
    width: 4.5rem; height: 4.5rem; border-radius: 50%; display: grid; place-items: center; background: var(--accent-tint); color: var(--accent);
    font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: -0.03em;
  }
  .person h3 { margin-top: 0.25rem; font-size: 1.6rem; line-height: 1.05; }
  .p-role { margin-top: 0.375rem; font-size: 0.92rem; font-weight: 600; color: var(--accent); }
  .p-bio { margin-top: 0.625rem; color: var(--muted); line-height: 1.55; max-width: 56ch; }
  .p-skills { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .p-skills li { padding: 0.375rem 0.75rem; border-radius: 62.4375rem; background: var(--bubble); font-size: 0.86rem; color: var(--ink-2); }
  .more { padding: 0.25rem 0.25rem 0; }
  @media (max-width: 900px) { .team-grid { grid-template-columns: 1fr; gap: 2.25rem; } }
  @media (max-width: 520px) { .person { grid-template-columns: 1fr; gap: 1rem; padding: 1.375rem; } .mono-av { width: 3.5rem; height: 3.5rem; font-size: 1.2rem; } }
</style>
