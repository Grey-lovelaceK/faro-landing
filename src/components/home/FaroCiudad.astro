---
// Banner 3D de la portada: Santiago de noche (Gran Torre Costanera, Mapocho y Costanera Norte, Sanhattan, casas bajas)
// y un faro en un cerro cuyo haz recorre la ciudad y encuentra tres locales. La escena es src/scripts/faro3d.js
// (three.js), que se descarga solo cuando el recuadro se acerca a la pantalla. Con el recuadro en pantalla, el scroll
// mueve la cámara y el haz por estaciones (scrub); sin JS, sin WebGL2, con movimiento reducido o en un equipo lento
// queda un póster sacado de la misma escena, con los tres locales encendidos.
//
// LOCALES: hoy los tres son FICTICIOS (nombres inventados, buscados en la web el 3-nov-2026 sin coincidencias en
// Santiago) y se rotulan «Ejemplo». Para poner un negocio real: "real": true + "permiso" (quién autorizó, por escrito,
// y cuándo). Sin "permiso" se sigue rotulando «Ejemplo». Nunca un real sin permiso.
import Icon from '../Icon.astro';
const locales = [
  { id: 'sangucheria', nombre: 'Sanguchería Don Lisandro', barrio: 'Plaza Ñuñoa', real: false, permiso: null,
    tarjeta: { tipo: 'maps', encabezado: 'Ficha en Google Maps', sub: 'Plaza Ñuñoa · Aparece cuando buscan «sanguchería cerca».' },
    escena: { x: -30, z: -86, w: 6.5, d: 5.5, h: 4.6, techo: 'dos-aguas' } },
  { id: 'barberia', nombre: 'Barbería Navaja Lenta', barrio: 'Barrio Italia', real: false, permiso: null,
    tarjeta: { tipo: 'resumen-ia', encabezado: 'Resumen de IA en Google', pregunta: 'barbería que atienda hoy en Barrio Italia',
      respuesta: 'El resumen cita a la {nombre} porque su página responde horario, servicios y cómo llegar.' },
    escena: { x: -13, z: -92, w: 7, d: 6, h: 5.2, techo: 'plano' } },
  { id: 'cafe', nombre: 'Café Tres Cuadras', barrio: 'Lastarria', real: false, permiso: null,
    tarjeta: { tipo: 'asistente', encabezado: 'Asistente de IA', pregunta: 'dónde tomar un café en Lastarria',
      respuesta: 'Te puedo nombrar el {nombre}, en Lastarria: su web deja claro qué ofrece, a qué hora abre y dónde está.' },
    escena: { x: -47, z: -96, w: 6, d: 5, h: 4.4, techo: 'dos-aguas' } },
];
const esReal = (l: (typeof locales)[number]) => l.real === true && !!l.permiso;
const partes = (t: string, n: string) => t.split('{nombre}');
const escenaJson = JSON.stringify(locales.map((l) => ({ id: l.id, escena: l.escena })));
---
<section class="sec f3-sec" id="faro" aria-labelledby="f3-h">
  <div class="wrap-sec">
    <div class="sec-head">
      <h2 id="f3-h">Cuando alguien pregunta, la luz cae en quien se deja ver.</h2>
      <p class="lead">Google y los asistentes de IA muestran a los negocios que entienden. Estos tres locales son de ejemplo, inventados; el trabajo es el mismo para el tuyo.</p>
    </div>
  </div>

  <div class="f3-track">
    <div class="f3-stage wrap-sec">
      <figure class="f3" data-f3 data-haz="poster" aria-label="Ilustración 3D: Santiago de noche, con la Gran Torre Costanera y un faro sobre un cerro. Su haz recorre la ciudad y encuentra tres locales de ejemplo, ficticios.">
        <picture class="f3-poster">
          <source media="(max-width: 640px)" type="image/avif" srcset="/img/faro3d/santiago-tall-720.avif">
          <source media="(max-width: 640px)" type="image/webp" srcset="/img/faro3d/santiago-tall-720.webp">
          <source type="image/avif" srcset="/img/faro3d/santiago-wide-1240.avif 1240w, /img/faro3d/santiago-wide-1860.avif 1860w" sizes="min(77.5rem, 100vw - 3rem)">
          <img src="/img/faro3d/santiago-wide-1240.webp" srcset="/img/faro3d/santiago-wide-1240.webp 1240w, /img/faro3d/santiago-wide-1860.webp 1860w" sizes="min(77.5rem, 100vw - 3rem)"
            width="1240" height="620" loading="lazy" decoding="async" alt="">
        </picture>
        {locales.map((l, i) => <span class="pin" data-b={i} aria-hidden="true"><i></i><span>{l.nombre}</span></span>)}
      </figure>
      <p class="f3-cap" aria-hidden="true"><span class="f3-cap-t">Ilustración 3D. Los tres locales son ejemplos ficticios.</span></p>
    </div>
  </div>

  <div class="wrap-sec">
    <ul class="f3-cards" role="list">
      {locales.map((l, i) => {
        const [a, b] = partes('respuesta' in l.tarjeta ? l.tarjeta.respuesta : '', l.nombre);
        return (
          <li class="f3-card" data-b={i}>
            <div class="c-top">
              <Icon name={l.tarjeta.tipo === 'maps' ? 'check' : 'sparkle'} size={18} stroke={2} />
              {l.tarjeta.encabezado}
              {!esReal(l) && <span class="c-ej">Ejemplo</span>}
            </div>
            {l.tarjeta.tipo === 'maps' ? (
              <>
                <p class="c-name">{l.nombre}</p>
                <p class="c-sub">{'sub' in l.tarjeta ? l.tarjeta.sub : ''}</p>
              </>
            ) : (
              <>
                <p class="c-q">{'pregunta' in l.tarjeta ? l.tarjeta.pregunta : ''}</p>
                <p class="c-a">{a}<strong>{l.nombre}</strong>{b}</p>
              </>
            )}
          </li>
        );
      })}
    </ul>
    <p class="f3-note">Ilustración 3D hecha por Faro°. Los negocios son ficticios; ningún cliente real aparece en ella.</p>
  </div>
  <script type="application/json" id="f3-locales" set:html={escenaJson} />
</section>

<script>
  // Decide si va el 3D en vivo, arma el scrub (el recuadro queda fijo mientras la cámara recorre las estaciones)
  // y carga three.js con import() solo cuando el recuadro se acerca. Sin JS, todo esto no existe: queda el póster.
  const sec = document.querySelector<HTMLElement>('.f3-sec');
  const fig = document.querySelector<HTMLElement>('[data-f3]');
  if (sec && fig) {
    const q = new URLSearchParams(location.search);
    const posterMode = q.has('f3poster');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
    const slow = (nav.hardwareConcurrency || 8) < 4 || (nav.deviceMemory || 8) < 4 || !!(nav.connection && nav.connection.saveData);
    let gl2 = false;
    try { gl2 = !!document.createElement('canvas').getContext('webgl2'); } catch (e) { gl2 = false; }
    const live = posterMode || (!reduced && !slow && gl2 && !q.has('nogl'));
    if (!live) {
      fig.dataset.hazMotivo = reduced ? 'movimiento-reducido' : slow ? 'equipo-lento' : 'sin-webgl2';
    } else {
      const IDS = ['heroe', 'servicios', 'local-0', 'local-1', 'local-2', 'cumbre'];
      const HOLD = 0.5;
      const track = sec.querySelector<HTMLElement>('.f3-track')!;
      const stage = sec.querySelector<HTMLElement>('.f3-stage')!;
      const capT = sec.querySelector<HTMLElement>('.f3-cap-t')!;
      const cards = [...sec.querySelectorAll<HTMLElement>('.f3-card')];
      const pins = [...fig.querySelectorAll<HTMLElement>('.pin')];
      const NOMBRES = pins.map((p) => p.textContent || '');
      const CAPS: Record<string, string> = {
        heroe: 'Santiago de noche, con la Gran Torre Costanera.',
        servicios: 'El haz recorre la ciudad y se encienden los barrios.',
        cumbre: 'El faro en su cerro, con la ciudad encendida.',
      };
      const sm = (a: number, b: number, x: number) => { const t = Math.min(1, Math.max(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
      if (!posterMode) sec.classList.add('f3-live');
      let stickTop = 0, run = 1;
      const medir = () => {
        if (posterMode) return;
        const vh = innerHeight, sh = stage.offsetHeight;
        stickTop = Math.max(72, (vh - sh) / 2 + 36);
        stage.style.top = stickTop + 'px';
        run = Math.round(vh * 1.25);
        track.style.height = (sh + run) + 'px';
      };
      // avance 0..1 mientras el recuadro está fijo
      const prog = () => Math.min(1, Math.max(0, (stickTop - track.getBoundingClientRect().top) / run));
      const estado = () => {
        const x = prog() * (IDS.length - 1); const i = Math.min(IDS.length - 2, Math.floor(x)); const f = x - i;
        return { i, w: sm(HOLD, 1, f), u: Math.min(1, f / HOLD) };
      };
      (window as any).__f3 = { ids: IDS, estado };
      let escena = '';
      const pintar = () => {
        const r = estado(); const e = r.w > 0.5 ? IDS[r.i + 1] : IDS[r.i];
        if (e === escena) return; escena = e; fig.dataset.vista = e;
        const k = e.startsWith('local-') ? +e.slice(6) : -1;
        capT.textContent = k >= 0 ? `El haz encuentra un local de ejemplo, ficticio: ${NOMBRES[k]}.` : CAPS[e] || '';
        cards.forEach((c, j) => c.classList.toggle('on', j === k));
      };
      // la escena llama a pintar() en cada cuadro: leyenda, pines y fichas nunca se desfasan del 3D
      (window as any).__f3.pintar = pintar;
      let pend = 0;
      addEventListener('scroll', () => { if (!pend) pend = requestAnimationFrame(() => { pend = 0; pintar(); }); }, { passive: true });
      new ResizeObserver(() => { medir(); pintar(); }).observe(stage);
      medir(); pintar();
      fig.dataset.haz = 'cargando';
      const cargar = () => import('../../scripts/faro3d.js').catch((e) => { console.error('faro3d', e); fig.dataset.haz = 'poster'; sec.classList.remove('f3-live'); medir(); });
      addEventListener('f3:poster', () => { sec.classList.remove('f3-live'); track.style.height = ''; stage.style.top = ''; });
      if (posterMode) cargar();
      else {
        const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { io.disconnect(); cargar(); } }, { rootMargin: '900px 0px' });
        io.observe(track);
      }
    }
  }
</script>

<style>
  .f3-sec .sec-head { margin-bottom: 2.25rem; }
  .f3-stage { position: relative; }
  .f3-live .f3-stage { position: sticky; }
  .f3 {
    position: relative; margin: 0; width: 100%; aspect-ratio: 2 / 1; max-height: calc(100svh - 10.5rem); overflow: hidden; isolation: isolate;
    border-radius: 1.75rem; border: 1px solid var(--line); background: #05070e;
  }
  .f3-poster, .f3-poster img, .f3 :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .f3-poster img { object-fit: cover; }
  .f3 :global(canvas) { opacity: 0; transition: opacity 1.1s var(--ease-out); }
  .f3[data-haz='vivo'] :global(canvas) { opacity: 1; }
  /* pines: el nombre corto del local que el haz encuentra (lo único escrito sobre la escena) */
  .pin { position: absolute; left: 0; top: 0; z-index: 2; width: 0; height: 0; pointer-events: none; display: none; }
  .f3[data-haz='vivo'] .pin { display: block; }
  .pin i { position: absolute; left: -6px; top: -6px; width: 12px; height: 12px; border-radius: 50%; background: #8b9bff; box-shadow: 0 0 0 3px rgba(91, 114, 255, 0.3); opacity: 0.55; }
  .pin > span {
    position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); white-space: nowrap; padding: 0.3rem 0.6rem; border-radius: 0.55rem;
    background: rgba(10, 13, 23, 0.88); border: 1px solid #34418a; color: #eaedf6; font-size: 0.78rem; font-weight: 600;
    opacity: 1; transition: opacity 0.45s;
  }
  /* en vivo, cada pin se muestra cuando el haz encuentra su local */
  .f3[data-haz='vivo'] .pin { opacity: 0; transition: opacity 0.45s; }
  .f3[data-haz='vivo'][data-vista^='local'] .pin { opacity: 1; }
  .f3[data-haz='vivo'] .pin > span { opacity: 0; }
  .f3[data-haz='vivo'][data-vista='local-0'] .pin[data-b='0'] > span,
  .f3[data-haz='vivo'][data-vista='local-1'] .pin[data-b='1'] > span,
  .f3[data-haz='vivo'][data-vista='local-2'] .pin[data-b='2'] > span { opacity: 1; }
  .f3[data-haz='vivo'][data-vista='local-0'] .pin[data-b='0'] i,
  .f3[data-haz='vivo'][data-vista='local-1'] .pin[data-b='1'] i,
  .f3[data-haz='vivo'][data-vista='local-2'] .pin[data-b='2'] i { opacity: 1; }
  .f3-cap { margin-top: 0.875rem; min-height: 1.4em; font-size: 0.92rem; color: var(--muted); }

  .f3-cards { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .f3-card {
    border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg); padding: 1rem 1.05rem 1.1rem;
    transition: border-color 0.4s, box-shadow 0.4s;
  }
  .f3-card.on { border-color: var(--accent-line); box-shadow: var(--shadow-card), 0 0 0 4px var(--accent-tint); }
  .c-top { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem; font-size: 0.84rem; font-weight: 600; color: var(--muted); }
  .c-top :global(svg) { color: var(--accent); }
  .c-ej { margin-left: auto; padding: 0.2rem 0.55rem; border-radius: 999px; background: var(--bubble); color: var(--ink-2); font-size: 0.76rem; font-weight: 600; }
  .c-name { font: 700 1.25rem/1.1 var(--font-display); letter-spacing: -0.03em; }
  .c-sub { margin-top: 0.25rem; font-size: 0.9rem; color: var(--muted); }
  .c-q { padding: 0.5rem 0.75rem; border-radius: var(--radius); background: var(--bubble); font-size: 0.9rem; color: var(--ink-2); }
  .c-a { margin-top: 0.55rem; font-size: 0.92rem; line-height: 1.45; color: var(--ink); }
  .c-a strong { color: var(--accent); }
  .f3-note { margin-top: 1rem; font-size: 0.84rem; color: var(--faint); }
  @media (max-width: 900px) { .f3-cards { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) {
    .f3 { aspect-ratio: 4 / 5; border-radius: 1.375rem; max-height: calc(100svh - 9rem); }
  }
</style>
