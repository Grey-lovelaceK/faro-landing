---
// Preguntas visibles. La portada arma el JSON-LD FAQPage con este mismo arreglo, así nunca se desalinean.
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<section class="sec faq" id="faq" aria-labelledby="faq-h">
  <div class="wrap-sec faq-grid">
    <div class="sec-head">
      <h2 id="faq-h">Lo que nos preguntan antes de partir.</h2>
    </div>
    <div class="faq-list">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary><span>{f.q}</span><span class="pm" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 3.5rem; align-items: start; }
  .faq-list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem;
    padding: 1.375rem 2px; font-weight: 650; font-size: 1.1rem; line-height: 1.35; transition: color 0.15s;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent); }
  .pm { position: relative; flex: none; width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid var(--line-strong); transition: background-color 0.2s, border-color 0.2s; }
  .pm::before, .pm::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.75rem; height: 1.8px; margin: -0.9px 0 0 -6px; background: currentColor; border-radius: 2px; transition: transform 0.25s var(--ease-out); }
  .pm::after { transform: rotate(90deg); }
  details[open] .pm { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  details[open] .pm::after { transform: rotate(0deg); }
  details p { padding: 0 3.5rem 1.5rem 2px; color: var(--muted); line-height: 1.65; max-width: 68ch; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; gap: 1.75rem; } details p { padding-right: 0; } }
</style>
