---
// Las cinco familias de servicio (orden inspirado en estudiovertical.cl): «Aparecer en Google» destacado (más ancho y tintado).
import Icon from '../Icon.astro';
const items = [
  { href: '/diseno-web', icon: 'monitor', title: 'Diseño web', body: 'Landing pages, sitios corporativos y tiendas online a medida.', price: 'Desde $290.000' },
  { href: '/seo-aeo-geo', icon: 'bars', title: 'Aparecer en Google', body: 'En Google Maps, en Google y en las respuestas de la IA (SEO, AEO y GEO).', price: 'Desde $150.000/mes', featured: true },
  { href: '/branding', icon: 'pen', title: 'Branding', body: 'Logo, identidad y manual de marca para que te reconozcan.', price: 'Desde $190.000' },
  { href: '/marketing-digital', icon: 'megaphone', title: 'Marketing digital', body: 'Anuncios en Google y Meta, redes sociales y correo.', price: 'Desde $120.000/mes' },
  { href: '/integraciones', icon: 'puzzle', title: 'Integraciones', body: 'Tu tienda conectada con tu ERP y tu courier.', price: 'Desde $250.000' },
] as const;
---
<ul class="bento" role="list">
  {items.map((s) => (
    <li class:list={['svc', { featured: 'featured' in s && s.featured }]}>
      <a href={s.href}>
        <span class="svc-icon"><Icon name={s.icon} size={30} stroke={2.2} /></span>
        <span class="svc-text">
          <span class="svc-title">{s.title}</span>
          <span class="svc-body">{s.body}</span>
          <span class="svc-foot">
            {'price' in s && s.price && <span class="svc-price num">{s.price}</span>}
            <span class="svc-arrow"><Icon name="arrow" size={28} stroke={1.9} /></span>
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .bento { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1.3fr 1fr 1fr 1fr; gap: 1rem; }
  .svc a {
    height: 100%; min-height: 10.9375rem; display: flex; flex-direction: column; gap: 0.875rem; padding: 1.25rem 1.25rem 1.125rem;
    background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--ink);
    transition: border-color 0.2s, transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }
  .svc a:hover { border-color: var(--accent-line); transform: translateY(-3px); box-shadow: var(--shadow-card); }
  .svc.featured a { background: var(--accent-tint); border-color: var(--accent-line); }
    .svc-icon { width: 3.4375rem; height: 3.4375rem; border-radius: var(--radius-sm); display: grid; place-items: center; background: var(--accent-tint); color: var(--accent); }
  .svc.featured .svc-body { max-width: 25ch; font-size: 0.96rem; margin-top: 0.1875rem; }
  .svc.featured .svc-icon { background: color-mix(in srgb, var(--accent) 6%, var(--accent-tint)); }
  .svc-text { flex: 1; display: flex; flex-direction: column; gap: 0.625rem; }
  .svc-title { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; line-height: 1.1; letter-spacing: -0.04em; }
  .svc-body { color: var(--muted); font-size: 0.9rem; line-height: 1.4; letter-spacing: -0.01em; }
  .svc-foot { margin-top: auto; padding-top: 0.375rem; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; color: var(--accent); }
  .svc-arrow { margin: -10px 0 0 -5px; color: color-mix(in srgb, var(--accent) 55%, var(--ink-2)); }
  .svc-price { font-size: 0.86rem; letter-spacing: 0.02em; color: color-mix(in srgb, var(--accent) 40%, var(--ink-2)); }
  @media (max-width: 1180px) { .bento { grid-template-columns: 1fr 1fr; grid-auto-flow: dense; } .svc.featured { grid-column: span 2; } .svc.featured .svc-body { max-width: 40ch; } }
  @media (max-width: 600px) { .bento { grid-template-columns: 1fr; } .svc.featured { grid-column: auto; } .svc a { min-height: 0; } .svc .svc-body { max-width: 34ch; } }
</style>
