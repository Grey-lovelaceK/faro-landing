  .ex-sub{margin:0 0 .75rem;color:var(--muted);font-size:.92rem}
  .ex-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:.5rem 1.125rem}
  .ex-list li{display:flex;align-items:center;gap:.625rem;font-size:.92rem}
  .ex-list li.n{color:var(--muted)}
  .ex-list .ico{margin-top:0}
  .ex-btn{display:inline-block;margin-top:.875rem;font-weight:600;font-size:.92rem}

  .psi .top,.ai .top{display:flex;align-items:center;gap:.875rem;flex-wrap:wrap}
  .psi .pscore{font:700 2.1rem/1 var(--font-display);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
  .psi .ph{flex:1;min-width:180px}
  .psi .ph .sub2{font-size:.84rem;color:var(--muted);margin-top:.2rem}
  .psi .badge{font-size:.78rem;padding:.25rem .625rem;border-radius:999px;border:1px solid var(--line);color:var(--muted)}
  .cwv{display:flex;flex-wrap:wrap;gap:.625rem;margin-top:1rem}
  .cwv .m{flex:1;min-width:120px;background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius-sm);padding:.75rem .875rem}
  .cwv .mn{font-size:.78rem;color:var(--muted);display:flex;align-items:center;gap:.375rem}
  .cwv .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto}
  .cwv .mv{font-weight:700;font-size:1.15rem;margin-top:.3rem;font-variant-numeric:tabular-nums}
  .cwv .mf{font-size:.78rem;margin-top:.2rem}
  .psi .note,.ai .note{font-size:.8rem;color:var(--faint);margin:.875rem 0 0}
  .psi.warnbox,.ai.warnbox{border-color:var(--warn)}
  .ai h3{flex:1;min-width:160px}
  .ai .verdict-badge{font-weight:700;font-size:.8rem;padding:.375rem .75rem;border-radius:999px;color:#fff}
  .ai .vb-si{background:var(--pass)}.ai .vb-parcial{background:var(--warn)}.ai .vb-no{background:var(--fail)}
  .ai .aiscore{font:700 1.5rem/1 var(--font-display);font-variant-numeric:tabular-nums}
  .ai .verdict{margin:.875rem 0 0;font-size:1rem;line-height:1.5}
  .ai .query,.pres .answer{margin-top:.875rem;background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius-sm);padding:.75rem .875rem;font-size:.9rem;line-height:1.55}
  .ai .query b,.pres .answer b{color:var(--muted);font-weight:600}
  .pres .answer b{display:block;font-size:.82rem;margin-bottom:.375rem}
  .ai .cat{font-size:.84rem;color:var(--muted);margin-top:.25rem}
  .ai .sect{margin-top:1rem}
  .ai .sect h4{font-size:.92rem;font-weight:700;color:var(--ink);margin:0 0 .5rem}
  .ai ul{margin:0;padding-left:1.125rem}
  .ai li{font-size:.92rem;margin:.3rem 0;line-height:1.45}
  .pres .grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:.625rem;margin-top:.875rem}
  .pres .grid4 div{background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius-sm);padding:.625rem .75rem;font-size:.84rem;color:var(--muted)}
  .pres .grid4 strong{display:block;font-size:.98rem;margin-top:.15rem}

  .cta{margin-top:1.875rem;background:#0a0d17;color:#eaedf6;border:1px solid #28304c;border-radius:28px;padding:2.5rem 1.5rem;text-align:center}
  .cta h3{margin:0 0 .5rem;font-size:1.6rem;color:#fff}
  .cta p{margin:0 auto 1.125rem;color:#9aa2bc;max-width:46ch;font-size:.95rem}
  .cta > a{display:inline-flex;align-items:center;height:3.25rem;padding:0 1.875rem;background:#5b72ff;color:#fff;font-weight:600;border-radius:var(--radius);text-decoration:none}
  .cta .alt{margin:1rem auto 0;padding-top:.875rem;border-top:1px solid #28304c;font-size:.9rem;max-width:48ch}
  .cta .alt a{color:#8b9bff;font-weight:600}

  /* ── Qué revisa · Cómo leer · Preguntas ─────────────────────── */
  .info{margin-top:4.5rem;border-top:1px solid var(--line);padding-top:3rem}
  .info h2{font-size:clamp(1.6rem,2.6vw,2.1rem);line-height:1;letter-spacing:-.035em;margin:0 0 1.125rem}
  .info-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
  .info-grid div{background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:1.125rem 1.25rem}
  .info-grid h3{font-size:1.2rem;margin:0 0 .375rem}
  .info-grid p{margin:0;color:var(--muted);font-size:.93rem;line-height:1.5}
  .faq{display:flex;flex-direction:column}
  .faq details{border-bottom:1px solid var(--line)}
  .faq summary{cursor:pointer;list-style:none;padding:1rem 0;font-weight:650;font-size:1.05rem;display:flex;justify-content:space-between;gap:.875rem}
  .faq summary:hover{color:var(--accent)}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"+";color:var(--accent);font-weight:700}
  .faq details[open] summary::after{content:"−"}
  .faq details p{color:var(--muted);font-size:.95rem;margin:0;padding-bottom:1rem;max-width:68ch}

  @media (max-width:900px){
    .lab--cabina .lab-stage,.lab--noche .lab-stage{grid-template-columns:1fr;gap:2rem}
    .lab--noche .lab-stage{border-radius:22px}
  }
  @media (max-width:640px){
    .lab-hero{padding-top:2rem}
    .seg{display:flex}
    .seg button{flex:1;padding:.5rem .5rem;font-size:.86rem}
    #f button,.nw-actions button,.lead form button{width:100%}
    .nw-grid,.info-grid,.ex-list{grid-template-columns:1fr}
    .pres .grid4{grid-template-columns:1fr 1fr}
    .pv-rows span{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    .lab *,.lab *::before,.lab *::after{animation:none !important;transition:none !important}
    .lab[data-state="scanning"] .pv-card::after{opacity:0}
  }
</style>

<script is:inline set:html={js[1]}></script>

<script is:inline>
  // Capa de la propuesta: selector con/sin web, estado del faro, carga por etapas y ejemplo real.
  // No toca el analizador: observa lo que este escribe en #out.
  (function () {
    var lab = document.querySelector('.lab'), outEl = document.getElementById('out');
    var fWeb = document.getElementById('f'), fNw = document.getElementById('fnw');
    var tW = document.getElementById('toWeb'), tN = document.getElementById('toNoWeb');
    var stages = document.getElementById('stages'), pv = document.getElementById('pvStatus');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function syncMode() {
      var nw = !fNw.hidden;
      lab.dataset.mode = nw ? 'noweb' : 'web';
      tW.setAttribute('aria-pressed', String(!nw));
      tN.setAttribute('aria-pressed', String(nw));
      if (pv && lab.dataset.state === 'idle') pv.textContent = nw ? 'Esperando tus datos' : 'Esperando tu dirección';
    }
    tW.addEventListener('click', syncMode);
    tN.addEventListener('click', syncMode);
    syncMode();

    document.getElementById('tryFaro').addEventListener('click', function () {
      if (!fNw.hidden) tW.click();
      document.getElementById('url').value = 'faroagencia.cl';
      if (fWeb.requestSubmit) fWeb.requestSubmit(); else fWeb.dispatchEvent(new Event('submit', { cancelable: true }));
    });

    var STEPS = {
      web: [['Conectando con tu sitio', 0], ['Leyendo SEO y vista en redes', 2500], ['Buscando señales para la IA (Schema, llms.txt)', 6000], ['Calculando tu nota por categoría', 10000]],
      noweb: [['Buscando tu negocio en internet', 0], ['Revisando Google Maps, reseñas e Instagram', 4000], ['Preguntándole a la IA si te recomienda', 9000]]
    };
    var timers = [];
    function stop() { timers.forEach(clearTimeout); timers = []; }
    function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; }

    function startStages() {
      stop();
      var mode = lab.dataset.mode, steps = STEPS[mode];
      var what = (document.getElementById(mode === 'web' ? 'url' : 'nwName').value || '').trim();
      stages.textContent = '';
      stages.appendChild(el('p', 'st-url', (mode === 'web' ? 'Revisando ' : 'Buscando a ') + what));
      var bar = el('div', 'st-bar'), fill = el('i'); bar.appendChild(fill); stages.appendChild(bar);
      var list = el('ol', 'st-list'), items = steps.map(function (s) { var li = el('li', '', s[0]); li.dataset.s = 'wait'; list.appendChild(li); return li; });
      stages.appendChild(list);
      var note = el('p', 'st-note', mode === 'web' ? 'Suele tardar entre 10 y 15 segundos.' : 'Suele tardar unos 15 segundos.');
      stages.appendChild(note);
      stages.hidden = false;
      steps.forEach(function (s, i) {
        timers.push(setTimeout(function () {
          items.forEach(function (li, j) { li.dataset.s = j < i ? 'done' : j === i ? 'now' : 'wait'; });
          fill.style.width = Math.round((i + 1) / (steps.length + 1) * 100) + '%';
        }, s[1]));
      });
      timers.push(setTimeout(function () { note.textContent = 'Algunos sitios tardan un poco más. Seguimos en eso.'; }, 17000));
      if (stages.scrollIntoView) stages.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
    }

    // El panel derecho muestra el resultado real (lo lee de lo que el analizador escribió en #out).
    var bodies = { web: lab.querySelector('.pv-web'), noweb: lab.querySelector('.pv-noweb') };
    var orig = bodies.web ? { web: bodies.web.innerHTML, noweb: bodies.noweb.innerHTML } : null;
    function resetPreview() { if (orig) { bodies.web.innerHTML = orig.web; bodies.noweb.innerHTML = orig.noweb; } }
    function paintRing(body, text, color, small) {
      var r = body.querySelector('.pv-ring');
      r.firstElementChild.textContent = text; r.classList.add('on'); r.classList.toggle('sm', !!small);
      r.style.borderColor = color; r.style.color = color;
    }
    function paintRow(li, text, color, pct) {
      if (!li) return;
      li.classList.add('on'); li.querySelector('span').textContent = text;
      if (color) li.querySelector('span').style.color = color;
      if (pct != null) li.querySelector('i').style.background = 'linear-gradient(to right,' + color + ' ' + pct + '%,var(--bubble) ' + pct + '%)';
    }
    function fillPreview() {
      if (!orig) return;
      var unlocked = !!document.getElementById('detail');
      var sc = outEl.querySelector('.scorecard'), pres = outEl.firstElementChild;
      if (sc) {
        var ring = sc.querySelector('.ring'), b = bodies.web;
        paintRing(b, ring.dataset.v, ring.style.getPropertyValue('--rc'));
        b.querySelector('.pv-k').textContent = sc.querySelector('h2').textContent;
        b.querySelector('.pv-d').textContent = 'Tu ' + sc.querySelector('.g').textContent + ', de 100 puntos.';
        outEl.querySelectorAll('.catpill').forEach(function (p) {
          var cv = p.querySelector('.cv'), li = null, name = p.querySelector('.cn').textContent.trim();
          b.querySelectorAll('.pv-rows li').forEach(function (x) { if (x.dataset.cat === name) li = x; });
          paintRow(li, cv.dataset.to + ' / 100', cv.style.color, cv.dataset.to);
        });
        b.querySelector('.pv-lock').hidden = unlocked;
      } else if (pres && pres.classList.contains('pres')) {
        var badge = pres.querySelector('.verdict-badge'), n = bodies.noweb;
        var kind = badge.classList.contains('vb-si') ? ['Sí', 'var(--pass)'] : badge.classList.contains('vb-parcial') ? ['A medias', 'var(--warn)'] : ['No', 'var(--fail)'];
        paintRing(n, kind[0], kind[1], true);
        n.querySelector('.pv-k').textContent = badge.textContent;
        n.querySelector('.pv-d').textContent = 'Lo que respondió la IA está abajo.';
        var cells = document.querySelectorAll('#detail .grid4 div'), rows = n.querySelectorAll('.pv-rows li');
        cells.forEach(function (c, i) { var st = c.querySelector('strong'); if (st && rows[i]) paintRow(rows[i], st.textContent, st.style.color); });
        n.querySelector('.pv-lock').hidden = unlocked;
      }
    }

    var last = 'idle';
    function sync() {
      var c = outEl.firstElementChild, st = 'idle';
      if (c && c.classList.contains('loading')) st = 'scanning';
      else if (c && (c.classList.contains('scorecard') || c.classList.contains('pres'))) st = 'ready';
      if (st === last) { if (st === 'ready') fillPreview(); return; }
      last = st; lab.dataset.state = st;
      if (st === 'ready') fillPreview(); else resetPreview();
      if (st === 'scanning') startStages(); else { stop(); stages.hidden = true; }
      if (st === 'ready') outEl.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      if (pv) pv.textContent = st === 'scanning' ? 'Buscando…' : st === 'ready' ? 'Listo: el detalle está abajo' : (lab.dataset.mode === 'noweb' ? 'Esperando tus datos' : 'Esperando tu dirección');
    }
    new MutationObserver(sync).observe(outEl, { childList: true });
  })();
</script>
