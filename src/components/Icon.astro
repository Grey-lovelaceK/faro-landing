<svg class={cls} width={size} height={size} style={`width:${size / 16}rem;height:${size / 16}rem`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round"
