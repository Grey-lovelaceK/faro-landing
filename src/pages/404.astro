---
// Migrado desde 404.html (27/28-sep-2026). Estilos y scripts de la página intactos (is:inline).
import Base from '../layouts/Base.astro';
const ld = [];
const headExtra = "<style>\n  html,body{overflow-x:clip}*{box-sizing:border-box}\n  body{margin:0;min-height:100vh;display:grid;place-items:center;background:var(--ground);color:var(--ink);font-family:var(--sans);padding:24px 16px;position:relative;overflow-x:hidden}\n  body::before{content:\"\";position:absolute;top:-20%;right:-10%;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,var(--accent) 0%,transparent 62%);opacity:.14;pointer-events:none}\n  main{position:relative;max-width:520px;text-align:center}\n  .code{font-size:.78rem;color:var(--accent);font-weight:600}\n  h1{font-size:clamp(2rem,6vw,3rem);font-weight:800;letter-spacing:-.03em;line-height:1.05;margin:14px 0 12px;text-wrap:balance}\n  p{color:var(--muted);margin:0 0 28px;line-height:1.6}\n  .links{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}\n  a{display:inline-flex;padding:11px 20px;border-radius:999px;font-weight:600;font-size:.94rem;text-decoration:none;border:1px solid var(--border);color:var(--ink)}\n  a.primary{background:var(--accent);border-color:var(--accent);color:#fff}\n  a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}\n</style>";
---
<Base
  title="Página no encontrada — Faro°"
  canonical="https://faroagencia.cl/404"
  ogType="website"
  noindex
  ld={ld}
  headExtra={headExtra}
>
  <main>
    <span class="code">404 · fuera del haz</span>
    <h1>Esta página no existe.</h1>
    <p>Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <div class="links">
      <a href="/" class="primary">Ir al inicio</a>
      <a href="/analiza">Analiza tu web</a>
      <a href="/integraciones">Integraciones</a>
    </div>
  </main>
</Base>
