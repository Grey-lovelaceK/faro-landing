---
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/home/HomeFooter.astro';
import Base from '../layouts/Base.astro';
const ld = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "@id": "https://faroagencia.cl/analiza#app",
        "name": "Analizador de web gratis de Faro°",
        "url": "https://faroagencia.cl/analiza",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "inLanguage": "es-CL",
        "isAccessibleForFree": true,
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "CLP"
        },
        "description": "Revisa gratis el SEO, las redes sociales, el rendimiento real (Core Web Vitals) y la visibilidad en asistentes de IA (AEO/GEO) de cualquier sitio web.",
        "provider": {
          "@id": "https://faroagencia.cl/#org",
          "@type": "ProfessionalService",
          "name": "Faro°",
          "url": "https://faroagencia.cl/"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Qué es un análisis SEO?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Es una revisión de tu sitio web para ver si Google puede encontrarlo, entenderlo y mostrarlo bien: título, descripción, encabezados, velocidad, versión para celular, datos estructurados y archivos como el sitemap. Este analizador lo hace en segundos con 21 puntos y además revisa si la IA puede citarte."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cada cuánto conviene analizar mi web?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Después de cada cambio importante (un rediseño, páginas nuevas o un cambio de hosting) y, si no tocas nada, una vez al mes. Es gratis, así que puedes repetirlo las veces que quieras."
            }
          },
          {
            "@type": "Question",
            "name": "¿El análisis es gratis?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sí. La nota general y el puntaje por categoría son gratis y sin registro. El detalle de cada punto, el rendimiento real con Google PageSpeed y el chequeo de IA se desbloquean dejando tu nombre y correo."
            }
          },
          {
            "@type": "Question",
            "name": "¿Qué es AEO y GEO?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "AEO (Answer Engine Optimization) y GEO (Generative Engine Optimization) son las prácticas para que los asistentes de IA, como ChatGPT, Perplexity, Gemini o los AI Overviews de Google, entiendan tu negocio y lo citen cuando alguien pregunta por lo que ofreces. Dependen de datos estructurados, contenido que responda preguntas concretas y archivos como llms.txt."
            }
          },
          {
            "@type": "Question",
            "name": "¿Por qué mi nota es baja si mi web se ve bien?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Porque Google y la IA no ven el diseño: leen el código. Una web puede verse muy bien y aun así no tener título optimizado, datos estructurados, sitemap o una versión rápida en celular. Eso es lo que mide el analizador."
            }
          },
          {
            "@type": "Question",
            "name": "¿Y si no tengo página web?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "También puedes revisarte. Elige «¿No tienes web?», escribe el nombre de tu negocio, tu rubro y tu comuna, y buscamos en internet lo que buscaría un cliente tuyo. Una IA lee esos resultados y te dice si te recomendaría, qué presencia tienes hoy (Google Maps, reseñas, Instagram) y qué hacer primero para aparecer."
            }
          },
          {
            "@type": "Question",
            "name": "¿Guardan mi sitio o mis datos?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No guardamos el análisis. Si dejas tu nombre y correo para ver el detalle, guardamos esos datos junto a la URL analizada y la nota, solo para contactarte por este análisis. El detalle está en nuestra política de privacidad."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cómo subo mi nota?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El informe completo te dice qué corregir primero. Puedes hacerlo tú o tu desarrollador, o pedirnos que lo dejemos en verde: lo hacemos como parte de nuestros planes de web y posicionamiento."
            }
          }
        ]
      }
    ]
  }
];
---
<Base
  title="Análisis SEO gratis de tu web online: Google y la IA | Faro°"
  description="Análisis SEO gratis y online de tu sitio web: revisamos 21 puntos de SEO, redes, velocidad y visibilidad en la IA (AEO/GEO). Pon tu URL y ve tu nota."
  canonical="https://faroagencia.cl/analiza"
  ogType="website"
  ogTitle="Analiza tu web gratis — Faro°"
  ogDescription="SEO, redes, rendimiento real y visibilidad en IA (AEO/GEO) de tu sitio, gratis y al instante."
  imageAlt="Faro°: que te encuentren en Google y en la IA"
  image="https://faroagencia.cl/blog/img/og-default.png"
  ld={ld}
>
  <SiteNav />

<main class="lab" data-state="idle" data-mode="web"><section class="lab-hero"><div class="lab-stage"><div class="lab-copy"><h1>Análisis SEO gratis de tu web: ¿te encuentran en Google y <span>en la IA?</span></h1><p class="sub" id="sub">Pon la URL de tu sitio y en segundos te damos tu nota de SEO, redes y buscadores con IA (AEO/GEO). Gratis. El detalle completo lo desbloqueas con tu nombre y correo.</p><div class="seg" role="group" aria-label="¿Tu negocio tiene sitio web?"><button type="button" id="toWeb" aria-pressed="true">Tengo sitio web</button><button type="button" id="toNoWeb" aria-pressed="false">Solo Instagram o WhatsApp</button></div><span id="nwSwitch" hidden></span><form id="f"><input type="text" inputmode="url" id="url" aria-label="Dirección de tu sitio web" placeholder="tunegocio.cl" autocomplete="off" autocapitalize="off" spellcheck="false" required><button id="btn" type="submit">Analizar</button></form><p class="hint">No guardamos tu sitio · analizamos la página pública, igual que Google · <button type="button" id="tryFaro">Ver un ejemplo real con faroagencia.cl</button></p><form id="fnw" class="nw-form" hidden><p class="nw-lead">Buscamos en internet lo que buscaría un cliente tuyo, se lo damos a una IA y vemos si te recomienda.</p><div class="nw-grid"><label>Nombre del negocio<input type="text" id="nwName" placeholder="Pastelería Lucía" maxlength="80" required></label><label>Rubro<input type="text" id="nwRubro" placeholder="pastelería" maxlength="60" required></label><label>Comuna<input type="text" id="nwComuna" placeholder="Macul" maxlength="60" required></label><label><span class="lt">Instagram <span>(opcional)</span></span><input type="text" id="nwIg" placeholder="@tunegocio" maxlength="60" autocapitalize="off" spellcheck="false"></label></div><div class="nw-actions"><button id="nwBtn" type="submit">Preguntarle a la IA</button></div></form></div><aside class="lab-preview" aria-label="Lo que vas a recibir"><div class="pv-card"><div class="pv-head"><svg class="beacon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="2.6" fill="currentColor" stroke="none"></circle><path class="b1" d="M7.2 7.2a6.8 6.8 0 0 0 0 9.6M16.8 7.2a6.8 6.8 0 0 1 0 9.6"></path><path class="b2" d="M4 4.4a10.8 10.8 0 0 0 0 15.2M20 4.4a10.8 10.8 0 0 1 0 15.2"></path></svg><p class="pv-title">Tu diagnóstico</p><p class="pv-status" id="pvStatus" role="status">Esperando tu dirección</p></div><div class="pv-body pv-web"><div class="pv-score"><div class="pv-ring"><span>—</span></div><div><p class="pv-k">Tu nota, de la A a la E</p><p class="pv-d">Gratis y sin registro.</p></div></div><ul class="pv-rows"><li data-cat="SEO"><b>SEO</b><span>título, H1, canonical, celular</span><i></i></li><li data-cat="Social"><b>Redes sociales</b><span>cómo se ve tu link al compartirlo</span><i></i></li><li data-cat="AEO / GEO"><b>AEO / GEO</b><span>Schema, llms.txt, preguntas frecuentes</span><i></i></li><li data-cat="Técnico"><b>Técnico</b><span>servidor, robots.txt, sitemap</span><i></i></li></ul><p class="pv-lock"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span>Con tu nombre y correo: los 21 puntos explicados, Google PageSpeed en celular y si la IA te cita.</span></p></div><div class="pv-body pv-noweb"><div class="pv-score"><div class="pv-ring"><span>?</span></div><div><p class="pv-k">¿Te recomienda la IA?</p><p class="pv-d">La respuesta, tal como la vería un cliente.</p></div></div><ul class="pv-rows"><li><b>Google Maps</b><span>si tu negocio aparece</span><i></i></li><li><b>Reseñas</b><span>cuántas y con qué nota</span><i></i></li><li><b>Instagram</b><span>si se encuentra tu perfil</span><i></i></li><li><b>Web</b><span>si hay una página tuya</span><i></i></li></ul><p class="pv-lock"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span>Con tu nombre y correo: a quién recomienda la IA en tu rubro y qué hacer primero.</span></p></div></div></aside></div></section><div class="lab-results"><div id="stages" role="status" aria-live="polite" hidden></div><div id="out"></div><section class="info" aria-labelledby="qrev">
      <h2 id="qrev">Qué revisa el analizador</h2>
      <div class="info-grid">
        <div><h3>SEO</h3><p>Título, meta descripción, encabezado H1, HTTPS, URL canónica, idioma declarado y adaptación a celular.</p></div>
        <div><h3>Redes sociales</h3><p>Etiquetas Open Graph (título, descripción e imagen) y tarjeta de X/Twitter: cómo se ve tu link al compartirlo.</p></div>
        <div><h3>AEO / GEO</h3><p>Datos estructurados (Schema.org), archivo llms.txt, profundidad del contenido y preguntas frecuentes: lo que usa la IA para entenderte y citarte.</p></div>
        <div><h3>Técnico</h3><p>Respuesta del servidor, velocidad de respuesta, robots.txt, sitemap.xml, favicon y textos alternativos en imágenes.</p></div>
        <div><h3>Rendimiento real</h3><p>Core Web Vitals medidos con Google PageSpeed Insights en celular: carga (LCP), estabilidad (CLS) e interactividad.</p></div>
        <div><h3>Chequeo de IA</h3><p>Le mostramos tu página a un modelo de IA y le preguntamos si te recomendaría ante una búsqueda típica de tu rubro, y por qué.</p></div>
      </div>
      <h2 style="margin-top:34px" id="como-leer">Cómo leer tu análisis SEO</h2>
      <div class="info-grid">
        <div><h3>A (85 a 100)</h3><p>Lo técnico está resuelto. Lo que te hace subir ahora es contenido útil, reseñas y enlaces desde otros sitios.</p></div>
        <div><h3>B (70 a 84)</h3><p>Buena base con algunos puntos en amarillo. Suelen ser arreglos rápidos: meta descripción, imagen para compartir o datos estructurados.</p></div>
        <div><h3>C (50 a 69)</h3><p>Google te puede encontrar, pero le cuesta entender de qué se trata tu negocio. Parte por el título, el H1 y la meta descripción.</p></div>
        <div><h3>D o E (menos de 50)</h3><p>Faltan cosas básicas, como HTTPS, versión para celular o un título. Conviene corregirlas antes de invertir en anuncios.</p></div>
      </div>
      <p style="color:var(--muted);margin-top:16px">Cada punto en rojo o amarillo trae su recomendación. Si quieres revisarlos uno por uno, sigue nuestro <a href="/blog/checklist-seo-21-puntos">checklist SEO de 21 puntos</a>. Si prefieres que lo hagamos nosotros, arma tu plan en el <a href="/cotizador">cotizador</a>.</p>
      <h2 style="margin-top:34px">Preguntas frecuentes</h2>
      <div class="faq">
        <details><summary>¿Qué es un análisis SEO?</summary><p>Es una revisión de tu sitio web para ver si Google puede encontrarlo, entenderlo y mostrarlo bien: título, descripción, encabezados, velocidad, versión para celular, datos estructurados y archivos como el sitemap. Este analizador lo hace en segundos con 21 puntos y además revisa si la IA puede citarte.</p></details>
        <details><summary>¿Cada cuánto conviene analizar mi web?</summary><p>Después de cada cambio importante (un rediseño, páginas nuevas o un cambio de hosting) y, si no tocas nada, una vez al mes. Es gratis, así que puedes repetirlo las veces que quieras.</p></details>
        <details><summary>¿El análisis es gratis?</summary><p>Sí. La nota general y el puntaje por categoría son gratis y sin registro. El detalle de cada punto, el rendimiento real con Google PageSpeed y el chequeo de IA se desbloquean dejando tu nombre y correo.</p></details>
        <details><summary>¿Qué es AEO y GEO?</summary><p>AEO (Answer Engine Optimization) y GEO (Generative Engine Optimization) son las prácticas para que los asistentes de IA, como ChatGPT, Perplexity, Gemini o los AI Overviews de Google, entiendan tu negocio y lo citen cuando alguien pregunta por lo que ofreces. Dependen de datos estructurados, contenido que responda preguntas concretas y archivos como llms.txt.</p></details>
        <details><summary>¿Por qué mi nota es baja si mi web se ve bien?</summary><p>Porque Google y la IA no ven el diseño: leen el código. Una web puede verse muy bien y aun así no tener título optimizado, datos estructurados, sitemap o una versión rápida en celular. Eso es lo que mide el analizador.</p></details>
        <details><summary>¿Y si no tengo página web?</summary><p>También puedes revisarte. Elige «¿No tienes web?», escribe el nombre de tu negocio, tu rubro y tu comuna, y buscamos en internet lo que buscaría un cliente tuyo. Una IA lee esos resultados y te dice si te recomendaría, qué presencia tienes hoy (Google Maps, reseñas, Instagram) y qué hacer primero para aparecer.</p></details>
        <details><summary>¿Guardan mi sitio o mis datos?</summary><p>No guardamos el análisis. Si dejas tu nombre y correo para ver el detalle, guardamos esos datos junto a la URL analizada y la nota, solo para contactarte por este análisis. El detalle está en nuestra política de privacidad.</p></details>
        <details><summary>¿Cómo subo mi nota?</summary><p>El informe completo te dice qué corregir primero. Puedes hacerlo tú o tu desarrollador, o pedirnos que lo dejemos en verde: lo hacemos como parte de nuestros planes de web y posicionamiento.</p></details>
      </div>
    </section></div></main>

  <SiteFooter />

<style is:global>
  :root{--pass:var(--good);--warn:#b8690a;--fail:#d63a3a}
  @media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--warn:#e0a24a;--fail:#f0716a}}
  :root[data-theme="dark"]{--warn:#e0a24a;--fail:#f0716a}
  @property --v{syntax:"<number>";inherits:false;initial-value:0}
  [hidden]{display:none !important}

  .lab *{box-sizing:border-box}
  .lab button{font:inherit}
  .lab h1,.lab h2,.lab h3{font-family:var(--font-display);font-weight:700;letter-spacing:-.03em;line-height:1.1;text-wrap:balance}
  .lab a{color:var(--accent)}

  /* ── Primer pliegue ─────────────────────────────────────────── */
  .lab-hero{width:min(77.5rem,100% - 2rem);margin-inline:auto;padding:3rem 0 1rem}
  .lab-copy{min-width:0}
  .lab h1{font-size:clamp(2rem,3.5vw,3.1rem);line-height:1;letter-spacing:-.035em;margin:0;max-width:20ch}
  .lab h1 span{color:var(--accent)}
  .lab .sub{color:var(--muted);font-size:clamp(1.02rem,1.3vw,1.18rem);line-height:1.55;margin:1.125rem 0 0;max-width:52ch}

  .seg{display:inline-flex;gap:.25rem;margin-top:1.75rem;padding:.25rem;background:var(--bubble);border:1px solid var(--line);border-radius:999px;max-width:100%}
  .seg button{border:1px solid transparent;background:none;color:var(--muted);font-weight:600;font-size:.92rem;padding:.5rem 1rem;border-radius:999px;cursor:pointer;transition:color .2s,background-color .2s,border-color .2s}
  .seg button:hover{color:var(--ink)}
  .seg button[aria-pressed="true"]{background:var(--bg);border-color:var(--line);color:var(--ink);box-shadow:0 1px 2px rgba(15,23,42,.06)}

  #f{display:flex;gap:.625rem;flex-wrap:wrap;margin-top:.875rem}
  .lab input[type=text],.lab input[type=email]{background:var(--bg);border:1px solid var(--line-strong);color:var(--ink);border-radius:var(--radius);padding:0 1rem;height:3.25rem;font:400 1rem/1.2 var(--font-body);transition:border-color .2s,box-shadow .2s}
  .lab input::placeholder{color:var(--faint)}
  .lab input[type=text]:focus,.lab input[type=email]:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 4px var(--accent-tint)}
  #url{flex:1;min-width:13rem;height:3.625rem;font-size:1.06rem}
  .lab button[type=submit]{display:inline-flex;align-items:center;justify-content:center;height:3.25rem;padding:0 1.875rem;border:1px solid transparent;border-radius:var(--radius);background:var(--accent);color:var(--on-accent);font-weight:600;font-size:1rem;cursor:pointer;white-space:nowrap;box-shadow:var(--shadow-btn);transition:transform .2s var(--ease-out),background-color .2s}
  .lab button[type=submit]:hover:not(:disabled){background:var(--accent-press);transform:translateY(-1px)}
  .lab button[type=submit]:disabled{opacity:.65;cursor:wait}
  #btn{height:3.625rem}
  .hint{font-size:.84rem;color:var(--faint);margin:.75rem 0 0;max-width:60ch}
  #tryFaro{background:none;border:none;padding:0;color:var(--accent);font-weight:600;cursor:pointer;text-decoration:underline;text-underline-offset:.18em}

  .nw-form{margin-top:.875rem}
  .nw-lead{margin:0 0 1rem;color:var(--muted);font-size:.95rem;max-width:52ch}
  .nw-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem .875rem}
  .nw-grid label{display:grid;gap:.375rem;font-size:.86rem;font-weight:600;color:var(--ink)}
  .nw-grid label .lt span{font-weight:400;color:var(--faint)}
  .nw-grid input{width:100%}
  .nw-actions{margin-top:1rem}


  /* Cabina de dos columnas: a la izquierda se escribe, a la derecha se ve el diagnóstico */
  .lab-stage{display:grid;grid-template-columns:1.15fr .85fr;gap:3rem;align-items:center}
  .lab-preview{position:relative;isolation:isolate;min-width:0}
  .lab-preview::before{content:"";position:absolute;inset:-14% -10%;z-index:-1;background:radial-gradient(closest-side,var(--halo),transparent);opacity:.75;animation:lab-breathe 7s ease-in-out infinite;transition:opacity .5s var(--ease-out)}
  .lab[data-state="ready"] .lab-preview::before{opacity:1;animation:none}
  @keyframes lab-breathe{0%,100%{transform:scale(.94);opacity:.55}50%{transform:scale(1.03);opacity:.85}}

  .pv-card{position:relative;overflow:hidden;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-lg);box-shadow:var(--shadow-card);padding:1.375rem 1.5rem 1.5rem}
  .pv-card::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;background:linear-gradient(100deg,transparent 30%,color-mix(in srgb,var(--accent) 16%,transparent) 50%,transparent 70%);transform:translateX(-100%)}
  .lab[data-state="scanning"] .pv-card::after{opacity:1;animation:lab-sweep 2.4s cubic-bezier(.4,0,.2,1) infinite}
  @keyframes lab-sweep{to{transform:translateX(100%)}}
  .pv-head{display:flex;align-items:center;gap:.625rem;padding-bottom:1rem;border-bottom:1px solid var(--line)}
  .beacon{color:var(--accent);flex:0 0 auto}
  .beacon .b1{opacity:.55}.beacon .b2{opacity:.25}
  .lab[data-state="scanning"] .beacon .b1{animation:lab-pulse 1.2s ease-in-out infinite}
  .lab[data-state="scanning"] .beacon .b2{animation:lab-pulse 1.2s ease-in-out .3s infinite}
  .lab[data-state="ready"] .beacon .b1,.lab[data-state="ready"] .beacon .b2{opacity:1}
  @keyframes lab-pulse{0%,100%{opacity:.2}50%{opacity:1}}
  .pv-title{margin:0;font-weight:600;font-size:.95rem;color:var(--ink)}
  .pv-status{margin:0 0 0 auto;font-size:.84rem;color:var(--faint);text-align:right}
  .lab[data-state="scanning"] .pv-status,.lab[data-state="ready"] .pv-status{color:var(--accent);font-weight:600}
  .lab[data-mode="web"] .pv-noweb,.lab[data-mode="noweb"] .pv-web{display:none}
  .pv-score{display:flex;align-items:center;gap:1rem;padding:1.125rem 0}
  .pv-ring{width:4.75rem;height:4.75rem;border-radius:50%;border:2px dashed var(--line-strong);display:grid;place-items:center;flex:0 0 auto;font:700 1.6rem/1 var(--font-display);color:var(--faint)}
  .pv-k{margin:0;font:700 1.2rem/1.1 var(--font-display);letter-spacing:-.03em;color:var(--ink)}
  .pv-d{margin:.25rem 0 0;font-size:.88rem;color:var(--muted)}
  .pv-rows{list-style:none;margin:0;padding:0;display:grid;gap:.75rem}
  .pv-rows li{display:grid;grid-template-columns:auto 1fr;gap:.125rem .625rem;align-items:baseline}
  .pv-rows b{font-size:.92rem;color:var(--ink)}
  .pv-rows span{font-size:.82rem;color:var(--faint);text-align:right}
  .pv-rows i{grid-column:1 / -1;height:6px;border-radius:99px;background:var(--bubble);margin-top:.25rem}
  .pv-rows li.on span{display:inline;color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums}
  .pv-ring.on{border-style:solid}
  .pv-ring.sm{font-size:.86rem;letter-spacing:-.02em}
  .pv-lock{display:flex;gap:.625rem;align-items:flex-start;margin:1.25rem 0 0;padding:.75rem .875rem;border:1px dashed var(--line-strong);border-radius:var(--radius);font-size:.84rem;line-height:1.45;color:var(--muted)}
  .pv-lock svg{color:var(--accent);flex:0 0 auto;margin-top:.15rem}

  /* ── Carga por etapas ───────────────────────────────────────── */
  .lab-results{width:min(64.6875rem,100% - 2rem);margin-inline:auto;padding:1.5rem 0 5rem}
  #out{scroll-margin-top:6rem}
  #out > .loading{display:none}
  #stages{background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-lg);padding:1.5rem;margin-top:.5rem;scroll-margin-top:6rem}
  .st-url{margin:0;font-weight:600;color:var(--ink);word-break:break-all}
  .st-bar{height:3px;border-radius:99px;background:var(--bubble);overflow:hidden;margin:.875rem 0 1.125rem}
  .st-bar i{display:block;height:100%;width:0;background:var(--accent);border-radius:99px;transition:width .8s var(--ease-out)}
  .st-list{list-style:none;margin:0;padding:0;display:grid;gap:.625rem}
  .st-list li{display:flex;align-items:center;gap:.75rem;font-size:.95rem;color:var(--faint);transition:color .3s}
  .st-list li::before{content:"";width:.875rem;height:.875rem;border-radius:50%;border:2px solid var(--line-strong);flex:0 0 auto;transition:background-color .3s,border-color .3s}
  .st-list li[data-s="now"]{color:var(--ink);font-weight:600}
  .st-list li[data-s="now"]::before{border-color:var(--accent);background:var(--accent);animation:lab-pulse 1.2s ease-in-out infinite}
  .st-list li[data-s="done"]{color:var(--muted)}
  .st-list li[data-s="done"]::before{border-color:var(--good);background:var(--good)}
  .st-note{margin:1rem 0 0;font-size:.84rem;color:var(--faint)}

  /* ── Resultados (mismas clases que /analiza, con tokens nuevos) ── */
  @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  @keyframes spin{to{transform:rotate(360deg)}}
  #out>*{animation:rise .55s var(--ease-out) both}
  #out>*:nth-child(2){animation-delay:.06s}
  #out>*:nth-child(3){animation-delay:.12s}
  #out>*:nth-child(n+4){animation-delay:.18s}
  .loading{display:flex;align-items:center;gap:.75rem;color:var(--muted);font-size:.92rem}
  .spin{width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite;flex:0 0 auto}
  .err{background:var(--bg);border:1px solid var(--fail);color:var(--fail);border-radius:var(--radius);padding:1rem 1.125rem;font-size:.94rem;margin-top:.5rem}

  .scorecard{display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-lg);padding:1.5rem;box-shadow:var(--shadow-card);margin-top:.5rem}
  .ring{--v:0;width:118px;height:118px;border-radius:50%;flex:0 0 auto;display:grid;place-items:center;background:conic-gradient(var(--rc) calc(var(--v)*1%),var(--bubble) 0);transition:--v 1.2s var(--ease-out)}
  .ring .inner{width:92px;height:92px;border-radius:50%;background:var(--bg);display:grid;place-items:center;text-align:center}
  .ring .num{font:700 2.1rem/1 var(--font-display);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
  .ring .g{font-size:.74rem;color:var(--muted);margin-top:.15rem}
  .scoremeta{flex:1;min-width:200px}
  .scoremeta h2{margin:0;font-size:1.5rem}
  .scoremeta .u{font-size:.84rem;color:var(--muted);word-break:break-all;margin-top:.3rem}
  .tallies{display:flex;gap:.875rem;flex-wrap:wrap;margin-top:.75rem;font-size:.86rem;font-weight:600}
  .tallies .p{color:var(--pass)}.tallies .w{color:var(--warn)}.tallies .f{color:var(--fail)}
  .cats{display:flex;flex-wrap:wrap;gap:.625rem;margin-top:1rem}
  .catpill{flex:1;min-width:140px;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:.75rem .875rem}
  .catpill .cn{font-size:.82rem;color:var(--muted)}
  .catpill .cv{font:700 1.5rem/1.1 var(--font-display);font-variant-numeric:tabular-nums}
  .track{height:6px;border-radius:99px;background:var(--bubble);overflow:hidden;margin-top:.375rem}
  .track>div{height:100%;border-radius:99px;width:0;transition:width 1s var(--ease-out) .15s}

  .lead,.psi,.ai,.extras{margin-top:1.625rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-lg);padding:1.5rem}
  .lead{border-color:var(--accent-line);box-shadow:0 0 0 4px var(--accent-tint)}
  .lead h3{margin:0 0 .375rem;font-size:1.36rem}
  .lead p{margin:0 0 1rem;color:var(--muted);font-size:.95rem;max-width:56ch}
  .lead form{display:flex;gap:.625rem;flex-wrap:wrap;margin:0}
  .lead form input{flex:1;min-width:200px}
  .lead .locked{display:flex;flex-wrap:wrap;gap:.5rem 1rem;margin:0 0 1rem;padding:0;list-style:none;font-size:.86rem;color:var(--ink-2)}
  .lead .locked li{display:flex;align-items:center;gap:.4rem}
  .lead .locked svg{flex:0 0 auto;color:var(--accent)}
  .lead .privacy{font-size:.8rem;color:var(--faint);margin:.625rem 0 0}
  .lead .optin{display:flex;gap:.5rem;align-items:flex-start;margin:.75rem 0 0;font-size:.86rem;color:var(--muted);cursor:pointer}
  .lead .optin input{margin-top:.2rem;accent-color:var(--accent)}
  .lead .ok{display:flex;gap:.75rem;align-items:flex-start}
  .lead .ok .ico{width:26px;height:26px;border-radius:8px;background:var(--pass);margin-top:0}
  .lead .ok h3{margin:0}
  .lead .leaderr{color:var(--fail);font-size:.86rem;margin:.625rem 0 0}

  .group{margin-top:1.75rem}
  .group h3{font-size:1.3rem;margin:0 0 .25rem}
  .check{display:flex;gap:.75rem;padding:.75rem 0;border-bottom:1px solid var(--line)}
  .ico{flex:0 0 auto;width:20px;height:20px;border-radius:6px;display:grid;place-items:center;font-size:.7rem;font-weight:800;color:#fff;margin-top:2px}
  .ico.pass{background:var(--pass)}.ico.warn{background:var(--warn)}.ico.fail{background:var(--fail)}
  .check .lbl{font-weight:600;font-size:.95rem}
  .check .tip{font-size:.88rem;color:var(--muted);margin-top:.25rem}

  .extras{display:grid;gap:1.375rem}
  .ex-sec h3,.psi h3,.ai h3{margin:0;font-size:1.3rem}
  .ex-sec h3{margin-bottom:.625rem}
  .chips-t{display:flex;flex-wrap:wrap;gap:.5rem}
  .chip-t{font-size:.86rem;color:var(--muted);padding:.375rem .75rem;border-radius:999px;border:1px solid var(--line)}
  .chip-t b{color:var(--ink);font-weight:650}
  .ex-sub{margin:0 0 .75rem;color:var(--muted);font-size:.92rem}
  .ex-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:.5rem 1.125rem}
  .ex-list li{display:flex;align-items:center;gap:.625rem;font-size:.92rem}
  .ex-list li.n{color:var(--muted)}
  .ex-list .ico{margin-top:0}
  .ex-btn{display:inline-block;margin-top:.875rem;font-weight:600;font-size:.92rem}

  .psi .top,.ai .top{display:flex;align-items:center;gap:.875rem;flex-wrap:wrap}
  .psi .pscore{font:700 2.1rem/1 var(--font-display);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
  .psi .ph{flex:1;min-width:180px}
  .psi .ph .sub2{font-size:.84rem;color:var(--muted);margin-top:.2rem}
  .psi .badge{font-size:.78rem;padding:.25rem .625rem;border-radius:999px;border:1px solid var(--line);color:var(--muted)}
  .cwv{display:flex;flex-wrap:wrap;gap:.625rem;margin-top:1rem}
  .cwv .m{flex:1;min-width:120px;background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius-sm);padding:.75rem .875rem}
  .cwv .mn{font-size:.78rem;color:var(--muted);display:flex;align-items:center;gap:.375rem}
  .cwv .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto}
  .cwv .mv{font-weight:700;font-size:1.15rem;margin-top:.3rem;font-variant-numeric:tabular-nums}
  .cwv .mf{font-size:.78rem;margin-top:.2rem}
  .psi .note,.ai .note{font-size:.8rem;color:var(--faint);margin:.875rem 0 0}
  .psi.warnbox,.ai.warnbox{border-color:var(--warn)}
  .ai h3{flex:1;min-width:160px}
  .ai .verdict-badge{font-weight:700;font-size:.8rem;padding:.375rem .75rem;border-radius:999px;color:#fff}
  .ai .vb-si{background:var(--pass)}.ai .vb-parcial{background:var(--warn)}.ai .vb-no{background:var(--fail)}
  .ai .aiscore{font:700 1.5rem/1 var(--font-display);font-variant-numeric:tabular-nums}
  .ai .verdict{margin:.875rem 0 0;font-size:1rem;line-height:1.5}
  .ai .query,.pres .answer{margin-top:.875rem;background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius-sm);padding:.75rem .875rem;font-size:.9rem;line-height:1.55}
  .ai .query b,.pres .answer b{color:var(--muted);font-weight:600}
  .pres .answer b{display:block;font-size:.82rem;margin-bottom:.375rem}
  .ai .cat{font-size:.84rem;color:var(--muted);margin-top:.25rem}
  .ai .sect{margin-top:1rem}
  .ai .sect h4{font-size:.92rem;font-weight:700;color:var(--ink);margin:0 0 .5rem}
  .ai ul{margin:0;padding-left:1.125rem}
  .ai li{font-size:.92rem;margin:.3rem 0;line-height:1.45}
  .pres .grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:.625rem;margin-top:.875rem}
  .pres .grid4 div{background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius-sm);padding:.625rem .75rem;font-size:.84rem;color:var(--muted)}
  .pres .grid4 strong{display:block;font-size:.98rem;margin-top:.15rem}

  .cta{margin-top:1.875rem;background:#0a0d17;color:#eaedf6;border:1px solid #28304c;border-radius:28px;padding:2.5rem 1.5rem;text-align:center}
  .cta h3{margin:0 0 .5rem;font-size:1.6rem;color:#fff}
  .cta p{margin:0 auto 1.125rem;color:#9aa2bc;max-width:46ch;font-size:.95rem}
  .cta > a{display:inline-flex;align-items:center;height:3.25rem;padding:0 1.875rem;background:#5b72ff;color:#fff;font-weight:600;border-radius:var(--radius);text-decoration:none}
  .cta .alt{margin:1rem auto 0;padding-top:.875rem;border-top:1px solid #28304c;font-size:.9rem;max-width:48ch}
  .cta .alt a{color:#8b9bff;font-weight:600}

  /* ── Qué revisa · Cómo leer · Preguntas ─────────────────────── */
  .info{margin-top:4.5rem;border-top:1px solid var(--line);padding-top:3rem}
  .info h2{font-size:clamp(1.6rem,2.6vw,2.1rem);line-height:1;letter-spacing:-.035em;margin:0 0 1.125rem}
  .info-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
  .info-grid div{background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);padding:1.125rem 1.25rem}
  .info-grid h3{font-size:1.2rem;margin:0 0 .375rem}
  .info-grid p{margin:0;color:var(--muted);font-size:.93rem;line-height:1.5}
  .faq{display:flex;flex-direction:column}
  .faq details{border-bottom:1px solid var(--line)}
  .faq summary{cursor:pointer;list-style:none;padding:1rem 0;font-weight:650;font-size:1.05rem;display:flex;justify-content:space-between;gap:.875rem}
  .faq summary:hover{color:var(--accent)}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"+";color:var(--accent);font-weight:700}
  .faq details[open] summary::after{content:"−"}
  .faq details p{color:var(--muted);font-size:.95rem;margin:0;padding-bottom:1rem;max-width:68ch}

  @media (max-width:900px){
    .lab-stage{grid-template-columns:1fr;gap:2rem}
  }
  @media (max-width:640px){
    .lab-hero{padding-top:2rem}
    .seg{display:flex}
    .seg button{flex:1;padding:.5rem .5rem;font-size:.86rem}
    #f button,.nw-actions button,.lead form button{width:100%}
    .nw-grid,.info-grid,.ex-list{grid-template-columns:1fr}
    .pres .grid4{grid-template-columns:1fr 1fr}
    .pv-rows span{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    .lab *,.lab *::before,.lab *::after{animation:none !important;transition:none !important}
    .lab[data-state="scanning"] .pv-card::after{opacity:0}
  }
</style>

<script is:inline>
  const f = document.getElementById('f'), out = document.getElementById('out'), btn = document.getElementById('btn');
  const esc = s => String(s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  const rc = v => v >= 70 ? 'var(--pass)' : v >= 40 ? 'var(--warn)' : 'var(--fail)';

  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = document.getElementById('url').value.trim();
    if (!url) return;
    btn.disabled = true; btn.textContent = 'Analizando…';
    out.innerHTML = '<div class="loading"><span class="spin"></span> Revisando ' + esc(url) + '… (10–15 seg)</div>';
    try {
      const r = await fetch('/api/analyze?url=' + encodeURIComponent(url));
      const d = await r.json();
      if (!d.ok) { out.innerHTML = '<div class="err">' + esc(d.error || 'No se pudo analizar.') + '</div>'; return; }
      render(d);
    } catch (err) {
      out.innerHTML = '<div class="err">Error de red. Intenta de nuevo.</div>';
    } finally {
      btn.disabled = false; btn.textContent = 'Analizar';
    }
  });

  // Muestra la nota + categorías gratis (gancho) y deja el detalle tras la puerta (nombre+correo).
  function render(d) {
    const col = rc(d.score);

    let h = `
      <div class="scorecard">
        <div class="ring" style="--v:0; --rc:${col}" data-v="${d.score}">
          <div class="inner"><div><div class="num" style="color:${col}" data-to="${d.score}">0</div><div class="g">nota ${d.grade}</div></div></div>
        </div>
        <div class="scoremeta">
          <h2>${veredicto(d.score)}</h2>
          <div class="u">${esc(d.url)}</div>
          <div class="tallies">
            <span class="p">✓ ${d.counts.pass} bien</span>
            <span class="w">▲ ${d.counts.warn} mejorable</span>
            <span class="f">✕ ${d.counts.fail} crítico</span>
          </div>
        </div>
      </div>
      <div class="cats">` +
      d.categories.map(c => `
        <div class="catpill">
          <div class="cn">${esc(c.name)}</div>
          <div class="cv" style="color:${rc(c.score)}" data-to="${c.score}">0</div>
          <div class="track"><div style="background:${rc(c.score)}" data-w="${c.score}"></div></div>
        </div>`).join('') +
      `</div>`;

    // Puerta: nombre + correo para desbloquear el informe completo.
    const lock = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>`;
    h += `<div class="lead" id="lead">
      <h3>Tu informe completo está listo</h3>
      <p>Ya tienes la nota. Déjanos tu nombre y correo y te mostramos el detalle al tiro, con qué corregir primero. Sin spam.</p>
      <ul class="locked">
        <li>${lock} Cada punto a mejorar, explicado</li>
        <li>${lock} Rendimiento real (Google PageSpeed)</li>
        <li>${lock} ¿Te menciona la IA? (AEO/GEO)</li>
      </ul>
      <form id="leadf">
        <input type="text" id="name" placeholder="Tu nombre" autocomplete="name" autocapitalize="words" required>
        <input type="email" id="email" placeholder="tucorreo@ejemplo.cl" autocomplete="email" required>
        <button id="leadbtn" type="submit">Ver informe completo</button>
      </form>
      <label class="optin"><input type="checkbox" id="mkt"> Quiero recibir consejos y novedades de Faro° (opcional, puedes darte de baja cuando quieras)</label>
      <p class="privacy">Usamos tus datos para enviarte este informe y contactarte por él · <a href="/privacidad" style="color:inherit">privacidad</a></p>
    </div>`;

    out.innerHTML = h;
    animateIn();
    wireGate(d);
  }

  // Construye y revela el detalle completo tras capturar el lead.
  function revealFull(d) {
    const order = ['SEO', 'AEO / GEO', 'Social', 'Técnico'];
    const groups = order.filter(o => d.checks.some(c => c.cat === o));
    let h = '';

    for (const g of groups) {
      h += `<div class="group"><h3>${esc(g)}</h3>`;
      for (const c of d.checks.filter(x => x.cat === g)) {
        const sym = c.status === 'pass' ? '✓' : c.status === 'warn' ? '!' : '✕';
        h += `<div class="check">
          <span class="ico ${c.status}">${sym}</span>
          <div>
            <div class="lbl">${esc(c.label)} <span style="color:var(--faint);font-weight:400;font-family:var(--mono);font-size:.78rem">— ${esc(c.detail)}</span></div>
            ${c.status !== 'pass' ? `<div class="tip">${esc(c.tip)}</div>` : ''}
          </div>
        </div>`;
      }
      h += `</div>`;
    }

    h += extrasBlock(d);
    h += `<div id="psi-slot"></div>`;
    h += `<div id="ai-slot"></div>`;

    h += ctaFor(d);

    const detail = document.createElement('div');
    detail.id = 'detail';
    detail.innerHTML = h;
    out.appendChild(detail);
    animateIn(detail);
    loadPageSpeed(d.url);
    loadAiCheck(d.url);
  }

  // Extras sin puntaje: con qué está hecha la web y qué datos del negocio lee Google (JSON-LD).
  function extrasBlock(d) {
    const tech = d.tech || [], u = d.understood;
    if (!tech.length && !u) return '';
    const chips = tech.map(t => `<span class="chip-t"><b>${esc(t.name)}</b> ${esc(t.kind)}</span>`).join('');
    const fields = u ? u.fields.map(f => `<li class="${f.ok ? 'y' : 'n'}"><span class="ico ${f.ok ? 'pass' : 'fail'}">${f.ok ? '✓' : '✕'}</span>${esc(f.label)}</li>`).join('') : '';
    const miss = u ? u.fields.filter(f => !f.ok).length : 0;
    return `<div class="extras">
      ${tech.length ? `<div class="ex-sec"><h3>Con qué está hecha tu web</h3><div class="chips-t">${chips}</div></div>` : ''}
      ${u ? `<div class="ex-sec"><h3>Qué entiende Google de tu negocio</h3>
        <p class="ex-sub">${u.business ? 'Tu web se presenta como <b>' + esc(u.business) + '</b> en sus datos estructurados.' : 'Tu web no le dice a Google qué tipo de negocio es (no tiene datos estructurados de negocio).'}${miss ? ' Faltan ' + miss + ' datos que Google y la IA usan para mostrarte.' : ''}</p>
        <ul class="ex-list">${fields}</ul>
        <a class="ex-btn" href="${esc(d.richResultsUrl)}" target="_blank" rel="noopener">Verlo en la prueba oficial de Google →</a></div>` : ''}
    </div>`;
  }

  // Cierre según el problema que mostró el análisis (tres públicos: base débil → web nueva;
  // web que no aparece → posicionamiento; web que ya va bien → traer visitas con campañas).
  // Siempre menciona las campañas de Meta para quien vende por redes. Precios = los publicados en /precios.
  const WA = m => 'https://wa.me/56973678880?text=' + encodeURIComponent(m);
  function ctaFor(d) {
    const cat = n => { const c = (d.categories || []).find(x => x.name === n); return c ? c.score : 100; };
    const seo = cat('SEO'), aeo = cat('AEO / GEO'), tec = cat('Técnico');
    let o;
    if (d.score < 50 || tec < 50) o = {
      h: 'Tu web necesita una base nueva',
      p: 'Con esta nota, arreglar punto por punto sale más caro que partir bien: una web rápida, clara y hecha desde el inicio para Google y la IA. Planes desde $290.000, pago único.',
      link: ['/diseno-web', 'Ver diseño web'], wa: 'Hola Faro°, analicé mi web y quiero una nueva',
    };
    else if (Math.min(seo, aeo) < 75) o = {
      h: 'Tu web existe, pero Google y la IA no la están mostrando',
      p: 'Si antes te llegaban clientes y ahora no, suele ser esto: la competencia te pasó en Google y los asistentes de IA no te recomiendan. Planes para aparecer en Google Maps desde $150.000 al mes, y en Google y la IA desde $350.000.',
      link: ['/seo-aeo-geo', 'Ver posicionamiento'], wa: 'Hola Faro°, analicé mi web y quiero volver a aparecer en Google',
    };
    else o = {
      h: 'Tu web va bien: el siguiente paso es traer más visitas',
      p: 'La base está. Ahora toca llevar gente: campañas en Google y en Meta (Instagram y Facebook), con presupuesto medido y reportes claros. Gestión desde $190.000 al mes más la inversión.',
      link: ['/marketing-digital', 'Ver marketing digital'], wa: 'Hola Faro°, mi web va bien y quiero más clientes', ads: true,
    };
    return `<div class="cta">
      <h3>${o.h}</h3>
      <p>${o.p}</p>
      <a href="${WA(o.wa)}" target="_blank" rel="noopener">Hablemos por WhatsApp</a>
      <p style="margin:12px auto 0; font-size:.86rem"><a href="${o.link[0]}" style="all:unset; cursor:pointer; text-decoration:underline">${o.link[1]}</a> · o escríbenos a <a href="mailto:contacto@faroagencia.cl?subject=Vi%20mi%20an%C3%A1lisis" style="all:unset; cursor:pointer; text-decoration:underline">contacto@faroagencia.cl</a></p>
      ${o.ads ? '' : `<p class="alt">¿Vendes por Instagram o Facebook? También gestionamos tus campañas en Meta para traer clientes mientras mejoramos tu web. <a href="/marketing-digital">Ver campañas →</a></p>`}
    </div>`;
  }

  // ── Modo «sin web»: ¿la IA conoce tu negocio? ──────────────────────────
  const fnw = document.getElementById('fnw'), nwSwitch = document.getElementById('nwSwitch');
  const sub = document.getElementById('sub'), subWeb = sub.textContent;
  const showNoWeb = (on) => {
    fnw.hidden = !on; f.hidden = on; nwSwitch.hidden = on;
    sub.textContent = on ? 'Sin web también se puede revisar: dinos el nombre de tu negocio, tu rubro y tu comuna, y vemos si la IA te recomienda cuando un cliente pregunta. Gratis.' : subWeb;
    document.querySelector('.hint').hidden = on; out.innerHTML = '';
    if (on) document.getElementById('nwName').focus();
  };
  document.getElementById('toNoWeb').addEventListener('click', () => showNoWeb(true));
  document.getElementById('toWeb').addEventListener('click', () => { showNoWeb(false); document.getElementById('url').focus(); });
