---
import BrandLogo from '../components/BrandLogo.astro';
// Migrado desde analiza.html (27/28-sep-2026). Estilos y scripts de la página intactos (is:inline).
import Base from '../layouts/Base.astro';
const ld = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "@id": "https://faroagencia.cl/analiza#app",
        "name": "Analizador de web gratis de Faro°",
        "url": "https://faroagencia.cl/analiza",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "inLanguage": "es-CL",
        "isAccessibleForFree": true,
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "CLP"
        },
        "description": "Revisa gratis el SEO, las redes sociales, el rendimiento real (Core Web Vitals) y la visibilidad en asistentes de IA (AEO/GEO) de cualquier sitio web.",
        "provider": {
          "@id": "https://faroagencia.cl/#org",
          "@type": "ProfessionalService",
          "name": "Faro°",
          "url": "https://faroagencia.cl/"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿El análisis es gratis?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sí. La nota general y el puntaje por categoría son gratis y sin registro. El detalle de cada punto, el rendimiento real con Google PageSpeed y el chequeo de IA se desbloquean dejando tu nombre y correo."
            }
          },
          {
            "@type": "Question",
            "name": "¿Qué es AEO y GEO?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "AEO (Answer Engine Optimization) y GEO (Generative Engine Optimization) son las prácticas para que los asistentes de IA, como ChatGPT, Perplexity, Gemini o los AI Overviews de Google, entiendan tu negocio y lo citen cuando alguien pregunta por lo que ofreces. Dependen de datos estructurados, contenido que responda preguntas concretas y archivos como llms.txt."
            }
          },
          {
            "@type": "Question",
            "name": "¿Por qué mi nota es baja si mi web se ve bien?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Porque Google y la IA no ven el diseño: leen el código. Una web puede verse muy bien y aun así no tener título optimizado, datos estructurados, sitemap o una versión rápida en celular. Eso es lo que mide el analizador."
            }
          },
          {
            "@type": "Question",
            "name": "¿Guardan mi sitio o mis datos?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No guardamos el análisis. Si dejas tu nombre y correo para ver el detalle, guardamos esos datos junto a la URL analizada y la nota, solo para contactarte por este análisis. El detalle está en nuestra política de privacidad."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cómo subo mi nota?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El informe completo te dice qué corregir primero. Puedes hacerlo tú o tu desarrollador, o pedirnos que lo dejemos en verde: lo hacemos como parte de nuestros planes de web y posicionamiento."
            }
          }
        ]
      }
    ]
  }
];
const headExtra = "<style>\n  :root{\n    --accent:#3D5AFE; --accent-2:#5B72FF; --accent-soft:#E4E8FF;\n    --ground:#EEF1F7; --surface:#FFFFFF; --surface-2:#E6EAF2; --border:#D5DBE8;\n    --ink:#111420; --muted:#59617A; --faint:#98A0B4;\n    --pass:#1f8f5f; --warn:#C9770A; --fail:#D63A3A;\n    --mono:ui-monospace,\"Cascadia Code\",\"SF Mono\",Menlo,Consolas,monospace;\n    --sans:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  }\n  @media (prefers-color-scheme:dark){:root{\n    --accent:#5B72FF; --accent-2:#7E90FF; --accent-soft:#171C33;\n    --ground:#0A0D17; --surface:#131829; --surface-2:#1A2036; --border:#28304C;\n    --ink:#EAEDF6; --muted:#9AA2BC; --faint:#5A6484;\n    --pass:#4FB98A; --warn:#E0A24A; --fail:#F0716A;\n  }}\n  :root[data-theme=\"dark\"]{--accent:#5B72FF;--accent-2:#7E90FF;--accent-soft:#171C33;--ground:#0A0D17;--surface:#131829;--surface-2:#1A2036;--border:#28304C;--ink:#EAEDF6;--muted:#9AA2BC;--faint:#5A6484;--pass:#4FB98A;--warn:#E0A24A;--fail:#F0716A;}\n  :root[data-theme=\"light\"]{--accent:#3D5AFE;--accent-2:#5B72FF;--accent-soft:#E4E8FF;--ground:#EEF1F7;--surface:#FFFFFF;--surface-2:#E6EAF2;--border:#D5DBE8;--ink:#111420;--muted:#59617A;--faint:#98A0B4;--pass:#1f8f5f;--warn:#C9770A;--fail:#D63A3A;}\n  *{box-sizing:border-box}\n  html,body{margin:0;padding:0}\n  body{background:var(--ground); color:var(--ink); font-family:var(--sans); line-height:1.55; min-height:100vh}\n  a{color:var(--accent); text-decoration:none}\n  .wrap{max-width:840px; margin:0 auto; padding:24px 20px 80px; position:relative; z-index:1}\n  /* Haz de luz de faro — barrido suave desde una \"lámpara\" superior. Puro CSS. */\n  #beam{position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden}\n  #beam::before{content:\"\"; position:absolute; top:-150px; left:50%; width:460px; height:460px;\n    transform:translateX(-50%); border-radius:50%;\n    background:radial-gradient(circle, color-mix(in srgb,var(--accent) 42%, transparent), transparent 62%);\n    filter:blur(34px); opacity:.55}\n  #beam .sweep{position:absolute; top:-160px; left:50%; width:1100px; height:1100px; margin-left:-550px;\n    transform-origin:50% 160px; will-change:transform;\n    background:conic-gradient(from -18deg at 50% 160px,\n      transparent 0deg,\n      color-mix(in srgb,var(--accent) 20%, transparent) 11deg,\n      color-mix(in srgb,var(--accent) 6%, transparent) 17deg,\n      transparent 26deg);\n    animation:sweep 9s ease-in-out infinite}\n  @keyframes sweep{0%{transform:rotate(-30deg)} 50%{transform:rotate(30deg)} 100%{transform:rotate(-30deg)}}\n  /* Anillo animable: registra --v como número para poder transicionarlo */\n  @property --v{syntax:\"<number>\"; inherits:false; initial-value:0}\n  @keyframes rise{from{opacity:0; transform:translateY(14px)} to{opacity:1; transform:none}}\n  header{display:flex; align-items:center; gap:14px; padding:6px 0 26px}\n  .brand{font-weight:800; letter-spacing:-.03em; font-size:1.2rem}\n  .brand b{color:var(--accent)}\n  .back{margin-left:auto; font-size:.86rem; color:var(--muted)}\n  .back:hover{color:var(--ink)}\n  .kicker{font-family:var(--mono); font-size:.72rem; letter-spacing:.16em; text-transform:uppercase; color:var(--accent); font-weight:600}\n  h1{font-size:clamp(1.8rem,4vw,2.6rem); letter-spacing:-.03em; line-height:1.05; margin:8px 0 0; text-wrap:balance}\n  .sub{color:var(--muted); margin-top:12px; max-width:56ch}\n  form{display:flex; gap:10px; margin-top:26px; flex-wrap:wrap}\n  #url{flex:1; min-width:220px; background:var(--surface); border:1px solid var(--border); color:var(--ink); border-radius:12px; padding:14px 16px; font-size:1rem; font-family:var(--mono)}\n  #url:focus{outline:2px solid var(--accent); outline-offset:1px; border-color:transparent}\n  button{cursor:pointer; border:none; background:var(--accent); color:#fff; font-weight:700; font-size:1rem; padding:14px 24px; border-radius:12px; font-family:var(--sans); transition:transform .15s, box-shadow .2s}\n  button:hover:not(:disabled){transform:translateY(-2px); box-shadow:0 10px 22px -8px var(--accent)}\n  button:disabled{opacity:.6; cursor:wait}\n  .hint{font-family:var(--mono); font-size:.74rem; color:var(--faint); margin-top:10px}\n  #out{margin-top:32px}\n  .loading{display:flex; align-items:center; gap:12px; color:var(--muted); font-family:var(--mono); font-size:.9rem}\n  .spin{width:18px;height:18px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite}\n  @keyframes spin{to{transform:rotate(360deg)}}\n  .err{background:var(--surface); border:1px solid var(--fail); color:var(--fail); border-radius:12px; padding:16px 18px; font-size:.94rem}\n  .scorecard{display:flex; gap:24px; align-items:center; background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:24px; flex-wrap:wrap}\n  .ring{--v:0; width:118px; height:118px; border-radius:50%; flex:0 0 auto; display:grid; place-items:center;\n    background:conic-gradient(var(--rc) calc(var(--v)*1%), var(--surface-2) 0);\n    transition:--v 1.2s cubic-bezier(.2,.75,.25,1);\n    box-shadow:0 0 34px -8px var(--rc)}\n  .ring .inner{width:92px;height:92px;border-radius:50%;background:var(--surface);display:grid;place-items:center;text-align:center}\n  .ring .num{font-family:var(--mono);font-weight:700;font-size:2rem;letter-spacing:-.03em;line-height:1}\n  .ring .g{font-family:var(--mono);font-size:.7rem;color:var(--muted)}\n  .scoremeta{flex:1; min-width:200px}\n  .scoremeta h2{margin:0; font-size:1.15rem; letter-spacing:-.02em}\n  .scoremeta .u{font-family:var(--mono); font-size:.8rem; color:var(--muted); word-break:break-all; margin-top:4px}\n  .tallies{display:flex; gap:14px; margin-top:12px; font-family:var(--mono); font-size:.8rem}\n  .tallies .p{color:var(--pass)} .tallies .w{color:var(--warn)} .tallies .f{color:var(--fail)}\n  .cats{display:flex; flex-wrap:wrap; gap:10px; margin-top:16px}\n  .catpill{flex:1; min-width:140px; background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:12px 14px}\n  .catpill .cn{font-family:var(--mono); font-size:.68rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted)}\n  .catpill .cv{font-family:var(--mono); font-weight:700; font-size:1.3rem}\n  .track{height:6px;border-radius:99px;background:var(--surface-2);overflow:hidden;margin-top:6px}\n  .track>div{height:100%;border-radius:99px;width:0;transition:width 1s cubic-bezier(.2,.75,.25,1) .15s}\n  .group{margin-top:26px}\n  .group h3{font-family:var(--mono); font-size:.74rem; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); margin:0 0 8px}\n  .check{display:flex; gap:12px; padding:12px 0; border-bottom:1px solid var(--border)}\n  .ico{flex:0 0 auto;width:20px;height:20px;border-radius:6px;display:grid;place-items:center;font-size:.7rem;font-weight:800;color:#fff;margin-top:2px}\n  .ico.pass{background:var(--pass)} .ico.warn{background:var(--warn)} .ico.fail{background:var(--fail)}\n  .check .lbl{font-weight:600; font-size:.94rem}\n  .check .det{font-family:var(--mono); font-size:.78rem; color:var(--muted); margin-top:2px}\n  .check .tip{font-size:.84rem; color:var(--faint); margin-top:4px}\n  .psi{margin-top:26px; background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:22px 24px}\n  .psi .top{display:flex; align-items:center; gap:16px; flex-wrap:wrap}\n  .psi .pscore{font-family:var(--mono); font-weight:700; font-size:2rem; letter-spacing:-.03em; line-height:1}\n  .psi .ph{flex:1; min-width:180px}\n  .psi .ph h3{margin:0; font-size:1.1rem; letter-spacing:-.02em}\n  .psi .ph .sub2{font-family:var(--mono); font-size:.74rem; color:var(--muted); margin-top:3px}\n  .psi .badge{font-family:var(--mono); font-size:.66rem; letter-spacing:.08em; text-transform:uppercase; padding:4px 9px; border-radius:999px; border:1px solid var(--border); color:var(--muted)}\n  .cwv{display:flex; flex-wrap:wrap; gap:10px; margin-top:16px}\n  .cwv .m{flex:1; min-width:120px; background:var(--ground); border:1px solid var(--border); border-radius:12px; padding:12px 14px}\n  .cwv .mn{font-family:var(--mono); font-size:.66rem; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); display:flex; align-items:center; gap:6px}\n  .cwv .dot{width:9px; height:9px; border-radius:50%; flex:0 0 auto}\n  .cwv .mv{font-family:var(--mono); font-weight:700; font-size:1.15rem; margin-top:5px; letter-spacing:-.02em}\n  .cwv .mf{font-family:var(--mono); font-size:.68rem; color:var(--faint); margin-top:3px}\n  .psi .note{font-family:var(--mono); font-size:.72rem; color:var(--faint); margin:14px 0 0}\n  .psi.warnbox{border-color:var(--warn)}\n  .ai{margin-top:26px; background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:22px 24px}\n  .ai .top{display:flex; align-items:center; gap:14px; flex-wrap:wrap}\n  .ai h3{margin:0; font-size:1.1rem; letter-spacing:-.02em; flex:1; min-width:160px}\n  .ai .verdict-badge{font-family:var(--mono); font-weight:700; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; padding:6px 12px; border-radius:999px; color:#fff}\n  .ai .vb-si{background:var(--pass)} .ai .vb-parcial{background:var(--warn)} .ai .vb-no{background:var(--fail)}\n  .ai .aiscore{font-family:var(--mono); font-weight:700; font-size:1.4rem; letter-spacing:-.02em}\n  .ai .verdict{margin:14px 0 0; font-size:.98rem; line-height:1.5}\n  .ai .query{margin-top:14px; background:var(--ground); border:1px solid var(--border); border-radius:10px; padding:11px 14px; font-family:var(--mono); font-size:.82rem}\n  .ai .query b{color:var(--muted); font-weight:600}\n  .ai .cat{font-family:var(--mono); font-size:.72rem; color:var(--muted); margin-top:4px}\n  .ai .sect{margin-top:16px}\n  .ai .sect h4{font-family:var(--mono); font-size:.7rem; letter-spacing:.1em; text-transform:uppercase; color:var(--accent); margin:0 0 8px}\n  .ai ul{margin:0; padding-left:18px}\n  .ai li{font-size:.9rem; margin:5px 0; line-height:1.45}\n  .ai .note{font-family:var(--mono); font-size:.7rem; color:var(--faint); margin:16px 0 0}\n  .ai.warnbox{border-color:var(--warn)}\n  .lead{margin-top:30px; background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:24px 26px}\n  .lead h3{margin:0 0 6px; font-size:1.15rem; letter-spacing:-.02em}\n  .lead p{margin:0 0 16px; color:var(--muted); font-size:.92rem; max-width:52ch}\n  .lead form{margin:0; gap:10px}\n  .lead input[type=email],.lead input[type=text]{flex:1; min-width:200px; background:var(--ground); border:1px solid var(--border); color:var(--ink); border-radius:12px; padding:13px 15px; font-size:1rem; font-family:var(--mono)}\n  .lead input:focus{outline:2px solid var(--accent); outline-offset:1px; border-color:transparent}\n  .lead .locked{display:flex; flex-wrap:wrap; gap:8px 16px; margin:0 0 16px; padding:0; list-style:none; font-family:var(--mono); font-size:.78rem; color:var(--muted)}\n  .lead .locked li{display:flex; align-items:center; gap:7px}\n  .lead .locked svg{flex:0 0 auto; color:var(--accent)}\n  .lead .privacy{font-family:var(--mono); font-size:.72rem; color:var(--faint); margin:10px 0 0}\n  .lead .optin{display:flex; gap:8px; align-items:flex-start; margin:12px 0 0; font-size:.84rem; color:var(--muted); cursor:pointer}\n  .lead .optin input{margin-top:3px; accent-color:var(--accent)}\n  .lead .ok{display:flex; gap:12px; align-items:flex-start}\n  .lead .ok .ico{flex:0 0 auto;width:26px;height:26px;border-radius:8px;display:grid;place-items:center;background:var(--pass);color:#fff;font-weight:800}\n  .lead .ok h3{margin:0}\n  .lead .leaderr{color:var(--fail); font-size:.84rem; margin:10px 0 0; font-family:var(--mono)}\n  .cta{margin-top:30px; background:var(--ink); color:var(--ground); border-radius:18px; padding:28px; text-align:center}\n  .cta h3{margin:0 0 8px; font-size:1.3rem; letter-spacing:-.02em; color:var(--ground)}\n  .cta p{margin:0 auto 18px; color:color-mix(in srgb,var(--ground) 66%,transparent); max-width:44ch; font-size:.94rem}\n  .cta a{display:inline-block; background:var(--accent); color:#fff; font-weight:700; padding:12px 24px; border-radius:999px}\n  /* Aparición escalonada de los bloques de resultado */\n  #out>*{animation:rise .55s cubic-bezier(.2,.75,.25,1) both}\n  #out>*:nth-child(2){animation-delay:.06s}\n  #out>*:nth-child(3){animation-delay:.12s}\n  #out>*:nth-child(4){animation-delay:.18s}\n  #out>*:nth-child(5){animation-delay:.24s}\n  #out>*:nth-child(6){animation-delay:.30s}\n  #out>*:nth-child(n+7){animation-delay:.36s}\n  .info{margin-top:56px; border-top:1px solid var(--border); padding-top:36px}\n  .info h2{font-size:1.5rem; letter-spacing:-.03em; margin:0 0 16px}\n  .info-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:14px}\n  @media (max-width:640px){ .info-grid{grid-template-columns:1fr} }\n  .info-grid div{background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:16px 18px}\n  .info-grid h3{font-family:var(--mono); font-size:.74rem; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); margin:0 0 6px}\n  .info-grid p{margin:0; color:var(--muted); font-size:.9rem}\n  .faq{display:flex; flex-direction:column; gap:10px}\n  .faq details{background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:0 18px}\n  .faq details[open]{border-color:var(--accent)}\n  .faq summary{cursor:pointer; list-style:none; padding:14px 0; font-weight:700; display:flex; justify-content:space-between; gap:14px}\n  .faq summary::-webkit-details-marker{display:none}\n  .faq summary::after{content:\"+\"; font-family:var(--mono); color:var(--accent); font-weight:700}\n  .faq details[open] summary::after{content:\"−\"}\n  .faq summary:focus-visible{outline:2px solid var(--accent); outline-offset:3px; border-radius:6px}\n  .faq details p{color:var(--muted); font-size:.92rem; margin:0; padding-bottom:16px}\n  @media (prefers-reduced-motion:reduce){\n    #beam .sweep{animation:none}\n    .ring{transition:none}\n    .track>div{transition:none}\n    #out>*{animation:none}\n  }\n</style>";
---
<Base
  title="Analizador SEO gratis: tu web en Google y en la IA | Faro°"
  description="Analizador gratuito de web: SEO, redes, AEO/GEO (visibilidad en IA) y técnico. Pon tu URL y obtén tu diagnóstico al instante."
  canonical="https://faroagencia.cl/analiza"
  ogType="website"
  ogTitle="Analiza tu web gratis — Faro°"
  ogDescription="SEO, redes, rendimiento real y visibilidad en IA (AEO/GEO) de tu sitio, gratis y al instante."
  imageAlt="Faro°: que te encuentren en Google y en la IA"
  image="https://faroagencia.cl/blog/img/og-default.png"
  ld={ld}
  headExtra={headExtra}
>
  <div id="beam" aria-hidden="true"><div class="sweep"></div></div>
  <div class="wrap">
    <header>
      <BrandLogo size={34} />
      <a href="/" class="back">← Volver</a>
    </header>

    <span class="kicker">Analizador gratis</span>
    <h1>¿Te encuentran en Google y en la IA?</h1>
    <p class="sub" id="sub">Pon la URL de tu sitio y en segundos te damos tu nota de SEO, redes y buscadores con IA (AEO/GEO). Gratis. El detalle completo lo desbloqueas con tu nombre y correo.</p>

    <form id="f">
      <input type="text" inputmode="url" id="url" placeholder="tunegocio.cl" autocomplete="off" autocapitalize="off" spellcheck="false" required>
      <button id="btn" type="submit">Analizar</button>
    </form>
    <p class="hint">// no guardamos tu sitio · analizamos la página pública, igual que Google</p>

    <!-- Modo «sin web»: para negocios que solo están en Instagram/WhatsApp. -->
    <p class="nw-switch" id="nwSwitch" hidden><button type="button" id="toNoWeb">¿No tienes web? Revisa si la IA conoce tu negocio →</button></p>
    <form id="fnw" class="nw-form" hidden>
      <p class="nw-lead">Buscamos en internet lo que buscaría un cliente tuyo, se lo damos a una IA y vemos si te recomienda.</p>
      <div class="nw-grid">
        <label>Nombre del negocio<input type="text" id="nwName" placeholder="Pastelería Lucía" maxlength="80" required></label>
        <label>Rubro<input type="text" id="nwRubro" placeholder="pastelería" maxlength="60" required></label>
        <label>Comuna<input type="text" id="nwComuna" placeholder="Macul" maxlength="60" required></label>
        <label><span class="lt">Instagram <span>(opcional)</span></span><input type="text" id="nwIg" placeholder="@tunegocio" maxlength="60" autocapitalize="off" spellcheck="false"></label>
      </div>
      <div class="nw-actions">
        <button id="nwBtn" type="submit">Preguntarle a la IA</button>
        <button type="button" class="nw-back" id="toWeb">Sí tengo web</button>
      </div>
    </form>

    <div id="out"></div>

    <section class="info" aria-labelledby="qrev">
      <h2 id="qrev">Qué revisa el analizador</h2>
      <div class="info-grid">
        <div><h3>SEO</h3><p>Título, meta descripción, encabezado H1, HTTPS, URL canónica, idioma declarado y adaptación a celular.</p></div>
        <div><h3>Redes sociales</h3><p>Etiquetas Open Graph (título, descripción e imagen) y tarjeta de X/Twitter: cómo se ve tu link al compartirlo.</p></div>
        <div><h3>AEO / GEO</h3><p>Datos estructurados (Schema.org), archivo llms.txt, profundidad del contenido y preguntas frecuentes: lo que usa la IA para entenderte y citarte.</p></div>
        <div><h3>Técnico</h3><p>Respuesta del servidor, velocidad de respuesta, robots.txt, sitemap.xml, favicon y textos alternativos en imágenes.</p></div>
        <div><h3>Rendimiento real</h3><p>Core Web Vitals medidos con Google PageSpeed Insights en celular: carga (LCP), estabilidad (CLS) e interactividad.</p></div>
        <div><h3>Chequeo de IA</h3><p>Le mostramos tu página a un modelo de IA y le preguntamos si te recomendaría ante una búsqueda típica de tu rubro, y por qué.</p></div>
      </div>
      <h2 style="margin-top:34px">Preguntas frecuentes</h2>
      <div class="faq">
        <details><summary>¿El análisis es gratis?</summary><p>Sí. La nota general y el puntaje por categoría son gratis y sin registro. El detalle de cada punto, el rendimiento real con Google PageSpeed y el chequeo de IA se desbloquean dejando tu nombre y correo.</p></details>
        <details><summary>¿Qué es AEO y GEO?</summary><p>AEO (Answer Engine Optimization) y GEO (Generative Engine Optimization) son las prácticas para que los asistentes de IA, como ChatGPT, Perplexity, Gemini o los AI Overviews de Google, entiendan tu negocio y lo citen cuando alguien pregunta por lo que ofreces. Dependen de datos estructurados, contenido que responda preguntas concretas y archivos como llms.txt.</p></details>
        <details><summary>¿Por qué mi nota es baja si mi web se ve bien?</summary><p>Porque Google y la IA no ven el diseño: leen el código. Una web puede verse muy bien y aun así no tener título optimizado, datos estructurados, sitemap o una versión rápida en celular. Eso es lo que mide el analizador.</p></details>
        <details><summary>¿Guardan mi sitio o mis datos?</summary><p>No guardamos el análisis. Si dejas tu nombre y correo para ver el detalle, guardamos esos datos junto a la URL analizada y la nota, solo para contactarte por este análisis. El detalle está en nuestra política de privacidad.</p></details>
        <details><summary>¿Cómo subo mi nota?</summary><p>El informe completo te dice qué corregir primero. Puedes hacerlo tú o tu desarrollador, o pedirnos que lo dejemos en verde: lo hacemos como parte de nuestros planes de web y posicionamiento.</p></details>
      </div>
    </section>
  </div>

<style is:global>
  [hidden]{display:none !important}
  .nw-switch{margin:14px 0 0}
  .nw-switch button,.nw-back{background:none; border:none; padding:0; color:var(--accent); font-weight:600; font-size:.95rem; cursor:pointer; box-shadow:none}
  .nw-switch button:hover,.nw-back:hover{text-decoration:underline; transform:none; box-shadow:none}
  .nw-form{margin-top:22px; background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:22px 24px; display:block}
  .nw-lead{margin:0 0 16px; color:var(--muted); font-size:.95rem}
  .nw-grid{display:grid; grid-template-columns:1fr 1fr; gap:12px 14px}
  @media (max-width:640px){ .nw-grid{grid-template-columns:1fr} }
  .nw-grid label{display:grid; gap:6px; font-size:.86rem; font-weight:600; color:var(--ink)}
  .nw-grid label .lt span{font-weight:400; color:var(--faint)}
  .nw-grid input{background:var(--ground); border:1px solid var(--border); color:var(--ink); border-radius:12px; padding:12px 14px; font-size:1rem; font-family:var(--sans)}
  .nw-grid input:focus{outline:2px solid var(--accent); outline-offset:1px; border-color:transparent}
  .nw-actions{display:flex; align-items:center; gap:18px; margin-top:16px; flex-wrap:wrap}
  .pres .top{display:flex; align-items:center; gap:14px; flex-wrap:wrap}
  .pres h3{margin:0; font-size:1.15rem; letter-spacing:-.02em; flex:1; min-width:180px}
  .pres .answer{margin:14px 0 0; background:var(--ground); border:1px solid var(--border); border-radius:12px; padding:14px 16px; font-size:.95rem; line-height:1.55}
  .pres .answer b{display:block; font-size:.8rem; color:var(--muted); font-weight:600; margin-bottom:6px}
  .pres .grid4{display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:14px}
  @media (max-width:640px){ .pres .grid4{grid-template-columns:1fr 1fr} }
  .pres .grid4 div{background:var(--ground); border:1px solid var(--border); border-radius:12px; padding:10px 12px; font-size:.84rem; color:var(--muted)}
  .pres .grid4 strong{display:block; font-size:.95rem; margin-top:2px}
  .pres .src{margin:14px 0 0; font-size:.8rem; color:var(--faint)}
  .cta .alt{margin:16px auto 0; padding-top:14px; border-top:1px solid color-mix(in srgb,var(--ground) 18%,transparent); font-size:.9rem; color:color-mix(in srgb,var(--ground) 72%,transparent); max-width:48ch}
  .cta .alt a{display:inline; background:none; padding:0; color:#8B9BFF; font-weight:600; border-radius:0}
</style>

<script is:inline>
  const f = document.getElementById('f'), out = document.getElementById('out'), btn = document.getElementById('btn');
  const esc = s => String(s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  const rc = v => v >= 70 ? 'var(--pass)' : v >= 40 ? 'var(--warn)' : 'var(--fail)';

  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = document.getElementById('url').value.trim();
    if (!url) return;
    btn.disabled = true; btn.textContent = 'Analizando…';
    out.innerHTML = '<div class="loading"><span class="spin"></span> Revisando ' + esc(url) + '… (10–15 seg)</div>';
    try {
      const r = await fetch('/api/analyze?url=' + encodeURIComponent(url));
      const d = await r.json();
      if (!d.ok) { out.innerHTML = '<div class="err">' + esc(d.error || 'No se pudo analizar.') + '</div>'; return; }
      render(d);
    } catch (err) {
      out.innerHTML = '<div class="err">Error de red. Intenta de nuevo.</div>';
    } finally {
      btn.disabled = false; btn.textContent = 'Analizar';
    }
  });

  // Muestra la nota + categorías gratis (gancho) y deja el detalle tras la puerta (nombre+correo).
  function render(d) {
    const col = rc(d.score);

    let h = `
      <div class="scorecard">
        <div class="ring" style="--v:0; --rc:${col}" data-v="${d.score}">
          <div class="inner"><div><div class="num" style="color:${col}" data-to="${d.score}">0</div><div class="g">nota ${d.grade}</div></div></div>
        </div>
        <div class="scoremeta">
          <h2>${veredicto(d.score)}</h2>
          <div class="u">${esc(d.url)}</div>
          <div class="tallies">
            <span class="p">✓ ${d.counts.pass} bien</span>
            <span class="w">▲ ${d.counts.warn} mejorable</span>
            <span class="f">✕ ${d.counts.fail} crítico</span>
          </div>
        </div>
      </div>
      <div class="cats">` +
      d.categories.map(c => `
        <div class="catpill">
          <div class="cn">${esc(c.name)}</div>
          <div class="cv" style="color:${rc(c.score)}" data-to="${c.score}">0</div>
          <div class="track"><div style="background:${rc(c.score)}" data-w="${c.score}"></div></div>
        </div>`).join('') +
      `</div>`;

    // Puerta: nombre + correo para desbloquear el informe completo.
    const lock = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>`;
    h += `<div class="lead" id="lead">
      <h3>Tu informe completo está listo</h3>
      <p>Ya tienes la nota. Déjanos tu nombre y correo y te mostramos el detalle al tiro, con qué corregir primero. Sin spam.</p>
      <ul class="locked">
        <li>${lock} Cada punto a mejorar, explicado</li>
        <li>${lock} Rendimiento real (Google PageSpeed)</li>
        <li>${lock} ¿Te menciona la IA? (AEO/GEO)</li>
      </ul>
      <form id="leadf">
        <input type="text" id="name" placeholder="Tu nombre" autocomplete="name" autocapitalize="words" required>
        <input type="email" id="email" placeholder="tucorreo@ejemplo.cl" autocomplete="email" required>
        <button id="leadbtn" type="submit">Ver informe completo</button>
      </form>
      <label class="optin"><input type="checkbox" id="mkt"> Quiero recibir consejos y novedades de Faro° (opcional, puedes darte de baja cuando quieras)</label>
      <p class="privacy">// usamos tus datos para enviarte este informe y contactarte por él · <a href="/privacidad" style="color:inherit">privacidad</a></p>
    </div>`;

    out.innerHTML = h;
    animateIn();
    wireGate(d);
  }

  // Construye y revela el detalle completo tras capturar el lead.
  function revealFull(d) {
    const order = ['SEO', 'AEO / GEO', 'Social', 'Técnico'];
    const groups = order.filter(o => d.checks.some(c => c.cat === o));
    let h = '';

    for (const g of groups) {
      h += `<div class="group"><h3>${esc(g)}</h3>`;
      for (const c of d.checks.filter(x => x.cat === g)) {
        const sym = c.status === 'pass' ? '✓' : c.status === 'warn' ? '!' : '✕';
        h += `<div class="check">
          <span class="ico ${c.status}">${sym}</span>
          <div>
            <div class="lbl">${esc(c.label)} <span style="color:var(--faint);font-weight:400;font-family:var(--mono);font-size:.78rem">— ${esc(c.detail)}</span></div>
            ${c.status !== 'pass' ? `<div class="tip">${esc(c.tip)}</div>` : ''}
          </div>
        </div>`;
      }
      h += `</div>`;
    }

    h += `<div id="psi-slot"></div>`;
    h += `<div id="ai-slot"></div>`;

    h += ctaFor(d);

    const detail = document.createElement('div');
    detail.id = 'detail';
    detail.innerHTML = h;
    out.appendChild(detail);
    animateIn(detail);
    loadPageSpeed(d.url);
    loadAiCheck(d.url);
  }

  // Cierre según el problema que mostró el análisis (tres públicos: base débil → web nueva;
  // web que no aparece → posicionamiento; web que ya va bien → traer visitas con campañas).
  // Siempre menciona las campañas de Meta para quien vende por redes. Precios = los publicados en /precios.
  const WA = m => 'https://wa.me/56986639327?text=' + encodeURIComponent(m);
  function ctaFor(d) {
    const cat = n => { const c = (d.categories || []).find(x => x.name === n); return c ? c.score : 100; };
    const seo = cat('SEO'), aeo = cat('AEO / GEO'), tec = cat('Técnico');
    let o;
    if (d.score < 50 || tec < 50) o = {
      h: 'Tu web necesita una base nueva',
      p: 'Con esta nota, arreglar punto por punto sale más caro que partir bien: una web rápida, clara y hecha desde el inicio para Google y la IA. Planes desde $290.000, pago único.',
      link: ['/diseno-web', 'Ver diseño web'], wa: 'Hola Faro°, analicé mi web y quiero una nueva',
    };
    else if (Math.min(seo, aeo) < 75) o = {
      h: 'Tu web existe, pero Google y la IA no la están mostrando',
      p: 'Si antes te llegaban clientes y ahora no, suele ser esto: la competencia te pasó en Google y los asistentes de IA no te recomiendan. Posicionamiento SEO · AEO · GEO desde $350.000 al mes.',
      link: ['/seo-aeo-geo', 'Ver posicionamiento'], wa: 'Hola Faro°, analicé mi web y quiero volver a aparecer en Google',
    };
    else o = {
      h: 'Tu web va bien: el siguiente paso es traer más visitas',
      p: 'La base está. Ahora toca llevar gente: campañas en Google y en Meta (Instagram y Facebook), con presupuesto medido y reportes claros. Gestión desde $250.000 al mes más la inversión.',
      link: ['/marketing-digital', 'Ver marketing digital'], wa: 'Hola Faro°, mi web va bien y quiero más clientes', ads: true,
    };
    return `<div class="cta">
      <h3>${o.h}</h3>
      <p>${o.p}</p>
      <a href="${WA(o.wa)}" target="_blank" rel="noopener">Hablemos por WhatsApp</a>
      <p style="margin:12px auto 0; font-size:.86rem"><a href="${o.link[0]}" style="all:unset; cursor:pointer; text-decoration:underline">${o.link[1]}</a> · o escríbenos a <a href="mailto:contacto@faroagencia.cl?subject=Vi%20mi%20an%C3%A1lisis" style="all:unset; cursor:pointer; text-decoration:underline">contacto@faroagencia.cl</a></p>
      ${o.ads ? '' : `<p class="alt">¿Vendes por Instagram o Facebook? También gestionamos tus campañas en Meta para traer clientes mientras mejoramos tu web. <a href="/marketing-digital">Ver campañas →</a></p>`}
    </div>`;
  }

  // ── Modo «sin web»: ¿la IA conoce tu negocio? ──────────────────────────
  // Se muestra con ?sinweb (prueba) o cuando el HTML trae data-noweb="on" en el body.
  const fnw = document.getElementById('fnw'), nwSwitch = document.getElementById('nwSwitch');
  if (new URLSearchParams(location.search).has('sinweb') || document.body.dataset.noweb === 'on') nwSwitch.hidden = false;
  const sub = document.getElementById('sub'), subWeb = sub.textContent;
  const showNoWeb = (on) => {
    fnw.hidden = !on; f.hidden = on; nwSwitch.hidden = on;
    sub.textContent = on ? 'Sin web también se puede revisar: dinos el nombre de tu negocio, tu rubro y tu comuna, y vemos si la IA te recomienda cuando un cliente pregunta. Gratis.' : subWeb;
    document.querySelector('.hint').hidden = on; out.innerHTML = '';
    if (on) document.getElementById('nwName').focus();
  };
  document.getElementById('toNoWeb').addEventListener('click', () => showNoWeb(true));
  document.getElementById('toWeb').addEventListener('click', () => { showNoWeb(false); document.getElementById('url').focus(); });
  if (new URLSearchParams(location.search).get('sinweb') === '1') showNoWeb(true); // enlace «Solo tengo Instagram» de la portada

  fnw.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = id => document.getElementById(id).value.trim();
    const q = { name: v('nwName'), rubro: v('nwRubro'), comuna: v('nwComuna'), ig: v('nwIg') };
    if (!q.name || !q.rubro || !q.comuna) return;
    const b = document.getElementById('nwBtn');
    b.disabled = true; b.textContent = 'Preguntando…';
    out.innerHTML = '<div class="loading"><span class="spin"></span> Preguntándole a la IA por ' + esc(q.rubro) + ' en ' + esc(q.comuna) + '… (~15 seg)</div>';
    try {
      const r = await fetch('/api/presence?' + new URLSearchParams(q));
      const d = await r.json();
      if (!d.ok) { out.innerHTML = '<div class="err">' + esc(d.error || 'No se pudo consultar.') + '</div>'; return; }
      renderNoWeb(d);
    } catch (err) {
      out.innerHTML = '<div class="err">Error de red. Intenta de nuevo.</div>';
    } finally { b.disabled = false; b.textContent = 'Preguntarle a la IA'; }
  });

  // Gratis: si la IA te nombró y su respuesta. Tras nombre + correo: presencia, a quién recomienda, qué hacer.
  function renderNoWeb(d) {
    const label = { si: 'Te recomienda', parcial: 'Apareces, pero no te recomienda', no: 'No te nombra' }[d.found];
    const vb = { si: 'si', parcial: 'parcial', no: 'no' }[d.found];
    const lock = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>`;
    out.innerHTML = `<div class="ai pres">
        <div class="top"><h3>¿La IA conoce a ${esc(d.business)}?</h3><span class="verdict-badge vb-${vb}">${esc(label)}</span></div>
        <div class="query"><b>Pregunta de un cliente:</b> "¿Dónde encuentro un buen negocio de ${esc(d.query)}?"</div>
        ${d.answer ? `<div class="answer"><b>Lo que respondió la IA</b>${esc(d.answer)}</div>` : ''}
        <p class="verdict">${esc(d.verdict)}</p>
      </div>
      <div class="lead" id="lead">
        <h3>Mira qué te falta para aparecer</h3>
        <p>Déjanos tu nombre y correo y te mostramos al tiro dónde estás y dónde no, a quién recomienda la IA en tu rubro y qué hacer primero. Sin spam.</p>
        <ul class="locked">
          <li>${lock} Tu presencia: Google Maps, reseñas, Instagram, web</li>
          <li>${lock} A quién recomienda la IA en tu rubro</li>
          <li>${lock} Qué hacer primero para aparecer</li>
        </ul>
        <form id="leadf">
          <input type="text" id="name" placeholder="Tu nombre" autocomplete="name" autocapitalize="words" required>
          <input type="email" id="email" placeholder="tucorreo@ejemplo.cl" autocomplete="email" required>
          <button id="leadbtn" type="submit">Ver qué me falta</button>
        </form>
        <label class="optin"><input type="checkbox" id="mkt"> Quiero recibir consejos y novedades de Faro° (opcional, puedes darte de baja cuando quieras)</label>
        <p class="privacy">Usamos tus datos para enviarte este resultado y contactarte por él · <a href="/privacidad" style="color:inherit">privacidad</a></p>
      </div>`;
    const lf = document.getElementById('leadf');
    lf.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('name').value.trim(), email = document.getElementById('email').value.trim();
      const lb = document.getElementById('leadbtn');
      const prev = document.querySelector('#lead .leaderr'); if (prev) prev.remove();
      if (!name || !email) return;
      lb.disabled = true; lb.textContent = 'Desbloqueando…';
      try {
        const r = await fetch('/api/lead', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name, email, kind: 'sinweb',
            url: [d.business, d.rubro, d.comuna].join(' · ') + (d.instagram ? ' · @' + d.instagram : ''),
            marketing: !!(document.getElementById('mkt') || {}).checked,
            checks: (d.actions || []).map(a => ({ cat: 'Qué hacer', label: a, status: 'warn', tip: '' })),
          }),
        });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) throw new Error(j.error || 'error');
        const first = name.split(' ')[0];
        document.getElementById('lead').innerHTML = '<div class="ok"><span class="ico">✓</span><div><h3>Listo' + (first ? ', ' + esc(first) : '') + ': aquí está lo que te falta.</h3>' +
          '<p style="margin:6px 0 0">' + (j.mailed ? 'También te enviamos una copia a tu correo. Si no la ves, revisa la carpeta de spam.' : 'Te escribiremos una vez a tu correo para ayudarte a aparecer. Sin spam.') + '</p></div></div>';
        revealNoWeb(d);
      } catch (err) {
        lb.disabled = false; lb.textContent = 'Ver qué me falta';
        const p = document.createElement('p'); p.className = 'leaderr';
        p.textContent = (err && err.message && err.message !== 'error') ? err.message : 'No se pudo guardar. Revisa los datos e intenta de nuevo.';
        lf.after(p);
      }
    });
  }

  function revealNoWeb(d) {
    const txt = { si: 'Sí', no: 'No', 'no se sabe': 'No se sabe' };
    const col = v => v === 'si' ? 'var(--pass)' : v === 'no' ? 'var(--fail)' : 'var(--muted)';
    const cell = (n, v) => `<div>${n}<strong style="color:${col(v)}">${txt[v] || '—'}</strong></div>`;
    const p = d.presence || {};
    const rec = (d.recommended || []).map(x => `<li>${esc(x)}</li>`).join('');
    const acts = (d.actions || []).map(x => `<li>${esc(x)}</li>`).join('');
    const src = (d.sources || []).map(s => esc(s.title)).join(' · ');
    const el = document.createElement('div');
    el.id = 'detail';
    el.innerHTML = `<div class="ai pres">
        <div class="top"><h3>Tu presencia hoy</h3></div>
        <div class="grid4">${cell('Google Maps', p.googleMaps)}${cell('Reseñas en Google', p.reviews)}${cell('Instagram', p.instagram)}${cell('Web', p.web)}</div>
        ${rec ? `<div class="sect"><h4>A quién recomienda la IA para «${esc(d.query)}»</h4><ul>${rec}</ul></div>` : ''}
        ${acts ? `<div class="sect"><h4>Qué hacer primero</h4><ul>${acts}</ul></div>` : ''}
        <p class="note">Consulta hecha hoy con ${esc(d.model || 'IA')}${d.grounded ? ' sobre una búsqueda real en internet' : ''}. Las respuestas de la IA cambian: tómalo como una prueba, no como una nota fija.${src ? ' Fuentes: ' + src + '.' : ''}</p>
      </div>
      <div class="cta">
        <h3>Te ayudamos a aparecer, aunque hoy no tengas web</h3>
        <p>Partimos por tu perfil de Google (Maps y reseñas), que es lo que más pesa cuando alguien busca cerca. Y cuando quieras, tu web: planes desde $290.000, pago único.</p>
        <a href="${WA('Hola Faro°, revisé si la IA conoce mi negocio y quiero aparecer')}" target="_blank" rel="noopener">Hablemos por WhatsApp</a>
        <p style="margin:12px auto 0; font-size:.86rem"><a href="/precios" style="all:unset; cursor:pointer; text-decoration:underline">Ver precios</a> · o escríbenos a <a href="mailto:contacto@faroagencia.cl?subject=Quiero%20aparecer%20en%20Google%20y%20la%20IA" style="all:unset; cursor:pointer; text-decoration:underline">contacto@faroagencia.cl</a></p>
        <p class="alt">¿Vendes por Instagram? Gestionamos tus campañas en Meta para que te lleguen clientes desde ya. Desde $250.000 al mes más la inversión. <a href="/marketing-digital">Ver campañas →</a></p>
      </div>`;
    out.appendChild(el);
  }

  const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Dispara las transiciones (anillo, barras) y cuenta los números hacia arriba.
  function animateIn(root) {
    root = root || out;
    const bars = root.querySelectorAll('.track > div[data-w]');
    const rings = root.querySelectorAll('.ring[data-v]');
    const nums = root.querySelectorAll('[data-to]');
    if (reduceMotion) {
      rings.forEach(el => el.style.setProperty('--v', el.dataset.v));
      bars.forEach(el => el.style.width = el.dataset.w + '%');
      nums.forEach(el => el.textContent = el.dataset.to);
      return;
    }
    requestAnimationFrame(() => requestAnimationFrame(() => {
      rings.forEach(el => el.style.setProperty('--v', el.dataset.v));
      bars.forEach(el => el.style.width = el.dataset.w + '%');
      nums.forEach(el => countUp(el, +el.dataset.to));
    }));
  }

  function countUp(el, to) {
    const dur = 1000, t0 = performance.now();
    const step = (t) => {
      const p = Math.min(1, (t - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3); // easeOutCubic
      el.textContent = Math.round(to * eased);
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = to;
    };
    requestAnimationFrame(step);
  }

  // ── Chequeo real de IA (¿te cita la IA?) ───────────────────────────────
  async function loadAiCheck(url) {
    const slot = document.getElementById('ai-slot');
    if (!slot) return;
    slot.innerHTML = '<div class="ai"><div class="loading"><span class="spin"></span> ' +
      'Preguntándole a la IA si te mencionaría… (~10 seg)</div></div>';
    try {
      const r = await fetch('/api/aicheck?url=' + encodeURIComponent(url));
      const d = await r.json();
      if (!d.ok) {
        slot.innerHTML = '<div class="ai warnbox"><div class="top"><h3>¿Te menciona la IA?</h3></div>' +
          '<p class="verdict" style="color:var(--muted)">No disponible: ' + esc(d.error || 'no se pudo consultar') + '</p></div>';
        return;
      }
      renderAi(slot, d);
    } catch (err) {
      slot.innerHTML = '<div class="ai warnbox"><div class="top"><h3>¿Te menciona la IA?</h3></div>' +
        '<p class="verdict" style="color:var(--muted)">No se pudo consultar la IA ahora.</p></div>';
    }
  }

  function renderAi(slot, d) {
    const label = { si: 'Sí te cita', parcial: 'A medias', no: 'No te cita' }[d.cited] || '—';
    const scCol = rc(d.aeoScore);
    const reasons = (d.reasons || []).map(x => `<li>${esc(x)}</li>`).join('');
    const actions = (d.actions || []).map(x => `<li>${esc(x)}</li>`).join('');

    slot.innerHTML = `<div class="ai">
      <div class="top">
        <h3>¿Te menciona la IA?</h3>
        <span class="verdict-badge vb-${esc(d.cited)}">${esc(label)}</span>
        <span class="aiscore" style="color:${scCol}">${d.aeoScore}<span style="font-size:.8rem;color:var(--muted)">/100 AEO</span></span>
      </div>
      <div class="cat">${esc(d.category || '—')}${d.location ? ' · ' + esc(d.location) : ''}</div>
      <p class="verdict">${esc(d.verdict)}</p>
      ${d.query ? `<div class="query"><b>consulta simulada:</b> "${esc(d.query)}"</div>` : ''}
      ${reasons ? `<div class="sect"><h4>Por qué</h4><ul>${reasons}</ul></div>` : ''}
      ${actions ? `<div class="sect"><h4>Para que la IA te cite</h4><ul>${actions}</ul></div>` : ''}
      <p class="note">// simulación con IA (${esc(d.model || 'modelo')}) · orientativo, no es la respuesta literal de ChatGPT</p>
    </div>`;
  }

  // ── Rendimiento real (PageSpeed Insights) ──────────────────────────────
  async function loadPageSpeed(url) {
    const slot = document.getElementById('psi-slot');
    if (!slot) return;
    slot.innerHTML = '<div class="psi"><div class="loading"><span class="spin"></span> ' +
      'Midiendo rendimiento real con Google PageSpeed… (puede tardar ~30 seg)</div></div>';
    try {
      const r = await fetch('/api/pagespeed?url=' + encodeURIComponent(url) + '&strategy=mobile');
      const d = await r.json();
      if (!d.ok) {
        slot.innerHTML = '<div class="psi warnbox"><div class="ph"><h3>Rendimiento real</h3>' +
          '<div class="sub2">No disponible: ' + esc(d.error || 'no se pudo medir') + '</div></div></div>';
        return;
      }
      renderPSI(slot, d);
    } catch (err) {
      slot.innerHTML = '<div class="psi warnbox"><div class="ph"><h3>Rendimiento real</h3>' +
        '<div class="sub2">No se pudo medir el rendimiento ahora.</div></div></div>';
    }
  }

  // Umbrales oficiales Core Web Vitals → clase de color
  const cwvColor = (kind, v) => {
    if (v == null) return 'var(--faint)';
    const t = {
      lcp: [2500, 4000], fcp: [1800, 3000], tbt: [200, 600], cls: [0.1, 0.25],
    }[kind];
    if (!t) return 'var(--faint)';
    return v <= t[0] ? 'var(--pass)' : v <= t[1] ? 'var(--warn)' : 'var(--fail)';
  };
  const fieldColor = (cat) =>
    cat === 'FAST' || cat === 'GOOD' ? 'var(--pass)' :
    cat === 'AVERAGE' || cat === 'NEEDS_IMPROVEMENT' ? 'var(--warn)' :
    cat === 'SLOW' ? 'var(--fail)' : 'var(--faint)';

  function renderPSI(slot, d) {
    const sc = d.perfScore;
    const scCol = sc == null ? 'var(--faint)' : rc(sc);
    const lab = d.lab || {};
    const field = d.field || null;

    const metrics = [
      { k: 'lcp', name: 'LCP', full: 'Carga', v: lab.lcp && lab.lcp.ms, disp: lab.lcp && lab.lcp.display, f: field && field.lcp },
      { k: 'cls', name: 'CLS', full: 'Estabilidad', v: lab.cls && lab.cls.value, disp: lab.cls && lab.cls.display, f: field && field.cls, scale: 1 },
      { k: 'tbt', name: 'INP≈', full: 'Interacción (TBT)', v: lab.tbt && lab.tbt.ms, disp: lab.tbt && lab.tbt.display, f: field && field.inp },
      { k: 'fcp', name: 'FCP', full: '1er contenido', v: lab.fcp && lab.fcp.ms, disp: lab.fcp && lab.fcp.display, f: field && field.fcp },
    ];

    const tiles = metrics.map(m => {
      const col = cwvColor(m.k, m.v);
      let f = '';
      if (m.f && m.f.category) {
        const fc = fieldColor(m.f.category);
        const p75 = m.f.p75 != null ? (m.k === 'cls' ? (m.f.p75 / 100).toFixed(2) : (m.f.p75 >= 1000 ? (m.f.p75 / 1000).toFixed(1) + ' s' : m.f.p75 + ' ms')) : '';
        f = `<div class="mf" style="color:${fc}">campo real: ${esc(p75)}</div>`;
      }
      return `<div class="m">
        <div class="mn"><span class="dot" style="background:${col}"></span>${esc(m.name)} · ${esc(m.full)}</div>
        <div class="mv" style="color:${col}">${esc(m.disp || '—')}</div>
        ${f}
      </div>`;
    }).join('');

    slot.innerHTML = `<div class="psi">
      <div class="top">
        <div class="pscore" style="color:${scCol}">${sc == null ? '—' : sc}<span style="font-size:.9rem;color:var(--muted)">/100</span></div>
        <div class="ph">
          <h3>Rendimiento real (Lighthouse)</h3>
          <div class="sub2">medido por Google PageSpeed · vista móvil</div>
        </div>
        <span class="badge">${field ? 'con datos de campo (CrUX)' : 'solo laboratorio'}</span>
      </div>
      <div class="cwv">${tiles}</div>
      <p class="note">// verde = bueno · ámbar = mejorable · rojo = lento, según umbrales Core Web Vitals de Google${field ? '' : ' · sin datos de campo: el sitio tiene poco tráfico para el reporte real de Google'}</p>
    </div>`;
  }

  function wireGate(d) {
    const lf = document.getElementById('leadf');
    if (!lf) return;
    lf.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('name').value.trim();
      const email = document.getElementById('email').value.trim();
      const lb = document.getElementById('leadbtn');
      const prevErr = document.querySelector('#lead .leaderr');
      if (prevErr) prevErr.remove();
      if (!name || !email) return;
      lb.disabled = true; lb.textContent = 'Desbloqueando…';
      try {
        const r = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name, email, url: d.url, score: d.score,
            marketing: !!(document.getElementById('mkt') || {}).checked,
            checks: (d.checks || []).map(c => ({ cat: c.cat, label: c.label, status: c.status, tip: c.tip })),
          }),
        });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) throw new Error(j.error || 'error');
        const first = name.split(' ')[0];
        document.getElementById('lead').innerHTML =
          '<div class="ok"><span class="ico">✓</span><div>' +
          '<h3>Listo' + (first ? ', ' + esc(first) : '') + ' — aquí está tu informe completo.</h3>' +
          '<p style="margin:6px 0 0">' + (j.mailed ? 'También te enviamos una copia a tu correo. Si no la ves, revisa la carpeta de spam.' : 'Te escribiremos una vez a tu correo para ofrecerte ayuda con los puntos en rojo. Sin spam.') + '</p>' +
          '</div></div>';
        revealFull(d);
      } catch (err) {
        lb.disabled = false; lb.textContent = 'Ver informe completo';
        const p = document.createElement('p');
        p.className = 'leaderr';
        p.textContent = (err && err.message && err.message !== 'error') ? err.message : 'No se pudo guardar. Revisa los datos e intenta de nuevo.';
        document.getElementById('leadf').after(p);
      }
    });
  }

  function veredicto(s) {
    if (s >= 85) return 'Excelente — vas muy bien.';
    if (s >= 70) return 'Bien, pero hay que afinar.';
    if (s >= 50) return 'Regular — dejas venta sobre la mesa.';
    if (s >= 30) return 'Débil — te están encontrando poco.';
    return 'Crítico — hoy eres casi invisible.';
  }
</script>
</Base>
