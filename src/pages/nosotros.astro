---
// Migrado desde nosotros.html (27/28-sep-2026). Estilos y scripts de la página intactos (is:inline).
import Base from '../layouts/Base.astro';
const ld = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AboutPage",
        "@id": "https://faroagencia.cl/nosotros#page",
        "url": "https://faroagencia.cl/nosotros",
        "name": "Nosotros — Faro°",
        "inLanguage": "es-CL",
        "isPartOf": {
          "@id": "https://faroagencia.cl/#website"
        },
        "about": {
          "@id": "https://faroagencia.cl/#org"
        },
        "mainEntity": {
          "@id": "https://faroagencia.cl/#org"
        }
      },
      {
        "@type": "Person",
        "@id": "https://faroagencia.cl/nosotros#cristian",
        "name": "Cristian Florez Revilla",
        "image": "https://faroagencia.cl/img/cristian.webp",
        "jobTitle": "Cofundador y director técnico",
        "worksFor": {
          "@id": "https://faroagencia.cl/#org"
        },
        "knowsAbout": [
          "Desarrollo web",
          "SEO técnico",
          "AEO",
          "GEO",
          "Integraciones e-commerce",
          "Bsale",
          "Defontana",
          "Analítica de datos"
        ]
      },
      {
        "@type": "Person",
        "@id": "https://faroagencia.cl/nosotros#clementina",
        "name": "Clementina Moya",
        "image": "https://faroagencia.cl/img/clementina.webp",
        "jobTitle": "Cofundadora y directora creativa y de marketing",
        "worksFor": {
          "@id": "https://faroagencia.cl/#org"
        },
        "knowsAbout": [
          "Marketing digital",
          "Copywriting",
          "Redacción",
          "Diseño",
          "Estrategia de marca",
          "Contenido para SEO"
        ]
      }
    ]
  }
];
const headExtra = "<style>\n  .team{display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-top:28px}\n  @media (max-width:640px){ .team{grid-template-columns:1fr} }\n  .person{background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:24px; display:flex; flex-direction:column; gap:12px}\n  .photo{width:140px; height:140px; border-radius:50%; background:linear-gradient(135deg,var(--accent),var(--accent-2)); color:#fff; display:grid; place-items:center; font-weight:800; font-size:1.8rem; letter-spacing:-.03em; overflow:hidden}\n  .photo img{width:100%; height:100%; object-fit:cover}\n  .person h3{margin:4px 0 0; font-size:1.3rem}\n  .person .role{font-size:.92rem; font-weight:600; color:var(--accent)}\n  .person p{margin:0; color:var(--muted); font-size:.95rem}\n  .person ul{margin:0; padding-left:18px; color:var(--muted); font-size:.92rem}\n  .principles{display:grid; grid-template-columns:repeat(2,1fr); gap:14px; margin-top:20px}\n  @media (max-width:640px){ .principles{grid-template-columns:1fr} }\n  .principles div{border-left:2px solid var(--accent); padding:4px 0 4px 16px}\n  .principles strong{display:block; color:var(--ink)}\n  .principles span{color:var(--muted); font-size:.94rem}\n  .mv{display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-top:20px}\n  @media (max-width:640px){ .mv{grid-template-columns:1fr} }\n  .mv div{background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:22px 24px}\n  .mv strong{display:block; font-family:var(--mono); font-size:.74rem; letter-spacing:.1em; text-transform:uppercase; color:var(--accent)}\n  .mv p{margin:10px 0 0; color:var(--ink); font-size:1.02rem; line-height:1.55}\n  .svc-links{display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-top:18px; padding:0; list-style:none}\n  @media (max-width:640px){ .svc-links{grid-template-columns:1fr} }\n  .svc-links a{display:block; background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:14px 16px; text-decoration:none; color:var(--ink); font-weight:600}\n  .svc-links a:hover{border-color:var(--accent)}\n  .svc-links small{display:block; font-weight:400; color:var(--muted); margin-top:2px}\n</style>";
---
<Base
  title="Nosotros: el equipo detrás de Faro° en Macul, Santiago"
  description="Faro° es un estudio de diseño web, marketing y posicionamiento en Macul. Conoce a Cristian Florez Revilla y Clementina Moya, qué hacemos y cómo trabajamos."
  canonical="https://faroagencia.cl/nosotros"
  ogType="website"
  ogTitle="Nosotros — Faro°"
  ogDescription="Un estudio, dos especialistas: desarrollo y datos por un lado, estrategia, redacción y diseño por el otro."
  imageAlt="Faro°: que te encuentren en Google y en la IA"
  image="https://faroagencia.cl/blog/img/og-default.png"
  blogCss
  ld={ld}
  headExtra={headExtra}
>
<header class="bar">
  <div class="in">
    <a href="/" class="brand">Faro<b>°</b></a>
    <nav>
      <a href="/#servicios" class="hide-sm">Servicios</a>
      <a href="/blog/" class="hide-sm">Blog</a>
      <a href="/analiza">Analiza tu web</a>
    </nav>
  </div>
</header>

<main class="wrap">
  <nav class="crumbs" aria-label="Ruta"><a href="/">Inicio</a> / Nosotros</nav>

  <span class="eyebrow" style="display:block; margin-top:18px">Nosotros</span>
  <h1>Un estudio, dos especialistas. Trabajas directo con nosotros.</h1>

  <div class="tldr">
    <strong>Quiénes somos</strong>
    <p>Faro° es un estudio chileno de diseño web, marketing y posicionamiento con base en Macul, Santiago. Somos dos socios: <strong>Cristian Florez Revilla</strong>, a cargo del desarrollo, el SEO técnico y las integraciones, y <strong>Clementina Moya</strong>, a cargo de la estrategia, la redacción y el diseño. Hacemos sitios que se encuentran en Google y en las respuestas de la IA, y que convierten esas visitas en clientes.</p>
  </div>

  <div class="prose">
    <h2 id="nombre">Por qué «Faro»</h2>
    <p>Un faro existe para que te encuentren de noche. Eso hacemos: que tu negocio aparezca cuando alguien lo busca, en Google, en Google Maps y, cada vez más, en asistentes de IA como ChatGPT o Gemini. De ahí el haz de luz azul que recorre nuestro sitio.</p>

    <h2 id="mision">Misión y visión</h2>
  </div>
  <div class="mv">
    <div><strong>Misión</strong><p>Ayudamos a pymes chilenas a que sus clientes las encuentren: en Google y en las respuestas de la inteligencia artificial. Diseñamos su web, la posicionamos y la conectamos con su negocio, con precios claros y trato directo con quienes hacen el trabajo.</p></div>
    <div><strong>Visión</strong><p>Ser el estudio al que acuden las pymes chilenas cuando quieren crecer en internet, reconocidas por resultados que se pueden ver, precios que se publican y un trato cercano.</p></div>
  </div>

  <div class="prose">
    <h2 id="equipo">El equipo</h2>
  </div>

  <div class="team">
    <article class="person" id="cristian">
      <div class="photo"><img src="/img/cristian.webp" alt="Foto de Cristian Florez Revilla" width="140" height="140" loading="lazy" decoding="async"></div>
      <div>
        <span class="role">Cofundador · Director técnico</span>
        <h3>Cristian Florez Revilla</h3>
      </div>
      <p>Desarrollador full stack. Construye los sitios, el SEO técnico, la visibilidad en IA y las integraciones entre tiendas online, ERP y courier.</p>
      <ul>
        <li>Desarrollo web a medida</li>
        <li>SEO técnico, AEO y GEO</li>
        <li>Integraciones con Bsale, Defontana y Enviame</li>
        <li>Analítica y reportes que miden ventas</li>
      </ul>
    </article>
    <article class="person" id="clementina">
      <div class="photo"><img src="/img/clementina.webp" alt="Foto de Clementina Moya" width="140" height="140" loading="lazy" decoding="async"></div>
      <div>
        <span class="role">Cofundadora · Directora creativa y de marketing</span>
        <h3>Clementina Moya</h3>
      </div>
      <p>Publicista. Define el mensaje que convierte, la identidad visual y la estrategia de contenido de cada proyecto.</p>
      <ul>
        <li>Estrategia y posicionamiento de marca</li>
        <li>Copywriting y contenido para SEO</li>
        <li>Diseño e identidad visual</li>
        <li>Campañas y redes sociales</li>
      </ul>
    </article>
  </div>

  <div class="prose">
    <h2 id="hacemos">Qué hacemos</h2>
  </div>
  <ul class="svc-links">
    <li><a href="/diseno-web">Diseño y desarrollo web<small>Sitios a medida, rápidos y listos para vender</small></a></li>
    <li><a href="/seo-aeo-geo">SEO · AEO · GEO<small>Que te encuentren en Google y en la IA</small></a></li>
    <li><a href="/marketing-digital">Marketing digital<small>Google y Meta Ads, contenido y correo</small></a></li>
    <li><a href="/integraciones">Integraciones<small>Tu tienda conectada con tu ERP y tu courier</small></a></li>
  </ul>

  <div class="prose">
    <h2 id="como">Cómo trabajamos</h2>
  </div>
  <div class="principles">
    <div><strong>Hablas con quien hace el trabajo</strong><span>Sin intermediarios ni call center: cada proyecto lo llevamos nosotros dos.</span></div>
    <div><strong>Precios publicados</strong><span>Sabes el rango desde el primer correo, y el alcance final queda por escrito.</span></div>
    <div><strong>Nada inventado</strong><span>No publicamos clientes, cifras ni testimonios que no existan. Lo que decimos, se puede comprobar.</span></div>
    <div><strong>Medimos lo que importa</strong><span>Reportes atados a consultas y ventas, no a métricas de vanidad.</span></div>
  </div>

  <aside class="cta">
    <h2>¿Conversamos sobre tu proyecto?</h2>
    <p>Cuéntanos qué necesitas y te respondemos con alcance, plazo y precio. O parte por el diagnóstico gratis de tu web.</p>
    <a href="https://wa.me/56986639327?text=Hola%20Faro%C2%B0%2C%20vengo%20desde%20su%20p%C3%A1gina%20Nosotros" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
    <a class="ghost" href="/analiza">Analiza tu web gratis</a>
  </aside>
</main>

<footer>
  <a href="/" style="color:inherit; text-decoration:none"><strong>Faro°</strong></a> · Macul, Santiago ·
  <a href="mailto:contacto@faroagencia.cl">contacto@faroagencia.cl</a> · <a href="/blog/">Blog</a> · <a href="/privacidad">Privacidad</a>
</footer>
</Base>
