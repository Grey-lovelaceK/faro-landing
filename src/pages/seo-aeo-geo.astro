    { "name": "Google Maps", "desc": "Tu Perfil de Empresa completo, con publicaciones, fotos y horarios, para salir cuando buscan cerca.", "price": "desde $150.000", "unit": "al mes", "tag": "Sirve sin web" },
    { "name": "Reseñas", "desc": "Enlace y código QR para pedir reseñas, y respuesta a cada una.", "tag": "Incluido desde Google Maps" },
    { "name": "SEO técnico", "desc": "Que Google pueda leer, entender y mostrar tu web: velocidad, indexación y datos estructurados.", "tag": "Desde Google + IA" },
    { "name": "Contenido que te encuentra", "desc": "Páginas y artículos que responden lo que buscan tus clientes, por servicio y por comuna.", "tag": "Desde Google + IA" },
    { "name": "Visibilidad en IA", "desc": "Que ChatGPT, Gemini y los AI Overviews te entiendan y te recomienden (AEO y GEO).", "tag": "Incluida desde el primer plan" },
    { "name": "Reporte mensual", "desc": "Llamadas, visitas, consultas y si la IA te nombra, explicado en palabras simples.", "tag": "En todos los planes" }
  ],
  "cardsTitle": "Qué hacemos",
  "goals": ["Salir en Google Maps", "Más llamadas", "Más consultas", "Más reseñas", "Aparecer en Google", "Que la IA te recomiende"],
  "steps": [
    { "t": "Diagnóstico", "d": "Pasamos tu web o tu negocio por el analizador y buscamos cómo te encuentra hoy un cliente." },
    { "t": "Estrategia", "d": "Elegimos las búsquedas que te traen clientes y el plan que tiene sentido para tu caso." },
    { "t": "Implementación", "d": "Perfil de Google, ajustes técnicos, contenido y datos para la IA, mes a mes." },
    { "t": "Medición", "d": "Cada mes te mostramos qué cambió: posiciones, llamadas, consultas y lo que responde la IA." }
