---
// Página de servicio: /seo-aeo-geo. Estructura, FAQ y JSON-LD en src/layouts/Service.astro.
import Service from '../layouts/Service.astro';
const page = {
  "slug": "seo-aeo-geo",
  "crumb": "SEO · AEO · GEO",
  "eyebrow": "Posicionamiento en Google y en la IA",
  "title": "Agencia SEO en Chile: posicionamiento en Google y la IA",
  "description": "Posicionamiento SEO, AEO y GEO en Chile: que te encuentren en Google, en Google Maps y en las respuestas de ChatGPT y Gemini. Desde $350.000 netos al mes.",
  "h1": "Posicionamiento SEO, AEO y GEO: que te encuentren en Google y en las respuestas de la IA",
  "tldr": "Trabajamos para que tu negocio aparezca cuando alguien lo busca: en los resultados de Google, en Google Maps y en asistentes de IA como ChatGPT, Gemini, Perplexity o los AI Overviews de Google. El plan mensual de <strong>SEO, AEO y GEO con contenido parte desde $350.000 netos al mes</strong>, con un mínimo de 3 meses, y el alcance de cada mes queda por escrito.",
