    "serviceType": "SEO",
    "provider": {
      "@id": "https://faroagencia.cl/#org",
      "@type": "ProfessionalService",
      "name": "Faro°",
      "url": "https://faroagencia.cl/"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Chile"
    },
    "description": "Posicionamiento en Google, Google Maps y asistentes de IA (AEO/GEO) con contenido mensual.",
