import '../styles/faro.css';

const faq = [
  { q: "¿Cuánto cuesta una página web con Faro°?", a: "Un sitio de hasta 5 secciones, con diseño a medida, SEO base, hosting y dominio .cl el primer año, parte desde $290.000 CLP netos (plan Presencia). Un sitio multipágina con blog y base AEO/GEO parte desde $790.000, y un e-commerce o desarrollo a medida desde $1.490.000. El precio final depende del alcance y te lo enviamos por escrito." },
  { q: "¿Qué es AEO y GEO, y en qué se diferencia del SEO?", a: "El SEO busca que aparezcas en los resultados de Google. El AEO y el GEO buscan que los asistentes de IA, como ChatGPT, Perplexity, Gemini o los AI Overviews de Google, entiendan tu negocio y te citen cuando alguien pregunta por lo que vendes. Se trabajan con datos estructurados, contenido que responde preguntas concretas y archivos como llms.txt." },
  { q: "¿Cuánto demora hacer mi sitio web?", a: "Un sitio del plan Presencia se entrega en 2 a 3 semanas. Los proyectos más grandes se planifican por etapas y el plazo queda escrito en la propuesta." },
  { q: "¿Atienden solo en Santiago?", a: "Tenemos base en Macul y podemos reunirnos en persona en Santiago. Diseño web, posicionamiento e integraciones los hacemos de forma remota para cualquier ciudad de Chile." },
  { q: "¿Cómo sé qué necesita mi web hoy?", a: "Pasa tu sitio por nuestro analizador gratis: en segundos te da una nota de SEO, redes y visibilidad en IA. Si prefieres, escríbenos y te hacemos una auditoría sin costo." },
];

