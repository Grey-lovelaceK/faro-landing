const preload = '<link rel="preload" href="/fonts/palanquin-dark-700-latin.woff2" as="font" type="font/woff2" crossorigin>';
---
<Base
  title="Faro° — Estudio web, marketing y posicionamiento SEO · AEO · GEO"
  description="Estudio chileno de diseño web, marketing y posicionamiento SEO, AEO y GEO. Que te encuentren en Google y en las respuestas de la IA."
  canonical="https://faroagencia.cl/"
  ogTitle="Faro° — Web, marketing y posicionamiento con IA"
  ogDescription="Diseñamos tu web a medida y la posicionamos en Google y en buscadores con IA (SEO · AEO · GEO)."
  twitterTitle="Faro° — Web, marketing y posicionamiento con IA"
  twitterDescription="Diseñamos tu web a medida y la posicionamos en Google y en buscadores con IA (SEO · AEO · GEO)."
  ld={ld}
  headExtra={preload}
>
  <SiteNav logo={40} />

  <main>
    <header class="hero">
      <div class="wrap hero-copy">
        <h1><span>No basta con salir en Google.</span> <span>Hay que salir en <em>la respuesta.</em></span></h1>
        <p class="hero-sub">Diseñamos tu web y la posicionamos en Google y en las respuestas de la IA.</p>
        <div class="hero-cta">
          <a href="/analiza" class="btn btn-primary">Analiza tu web gratis</a>
          <a href="https://wa.me/56986639327?text=Hola%20Faro%C2%B0%2C%20vengo%20desde%20su%20sitio%20web" class="btn btn-ghost" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
        </div>
      </div>
      <div class="hero-demo wrap"><AiCard /></div>
    </header>

    <section id="servicios" class="services wrap-wide" aria-label="Servicios">
      <ServiceBento />
    </section>
    <Paths />
    <Visibility />
    <Process />
    <Pricing />
    <Team />
    <HomeFaq items={faq} />
    <ClosingCta />
  </main>
  <HomeFooter />

  <script is:inline>
    (function () {
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var fold = innerHeight;
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add(e.target.classList.contains('steps') ? 'lit' : 'in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -12% 0px' });
      var groups = ['.sec-head', '.path-grid > li', '.vis-row', '.plan', '.extra', '.person', '.faq-list details', '.night', '.step'];
      groups.forEach(function (sel) {
        var i = 0, last = null;
        document.querySelectorAll('main ' + sel).forEach(function (el) {
          if (el.getBoundingClientRect().top < fold) return;
          if (el.parentElement !== last) { i = 0; last = el.parentElement; }
          el.style.setProperty('--i', i++); el.classList.add('rv'); io.observe(el);
        });
      });
      var st = document.querySelector('main .steps');
      if (st && st.getBoundingClientRect().top >= fold) { st.classList.add('dim'); io.observe(st); }
    })();
  </script>
</Base>

<style>
  .hero { padding: 3rem 0 2.75rem; overflow-x: clip; }
  .hero-copy { text-align: center; }
  .hero h1 { font-size: clamp(2.5rem, 4.75vw, 4.56rem); line-height: 0.93; letter-spacing: -0.035em; max-width: 57.5rem; margin-inline: auto; }
  .hero h1 span { display: block; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .hero-sub { margin: 1.125rem auto 0; max-width: 64ch; font-size: clamp(1.08rem, 1.6vw, 1.5rem); line-height: 1.35; color: var(--muted); }
  .hero-cta { margin-top: 1.25rem; display: flex; justify-content: center; gap: 0.9375rem; flex-wrap: wrap; }
  .hero-demo { margin-top: 2.125rem; }
  .services { padding-bottom: 0; }
  @media (max-width: 640px) {
    .hero { padding: 2.25rem 0 2rem; }
    .hero-cta .btn { width: 100%; }
    .hero-demo { margin-top: 1.75rem; }
  }
</style>
